<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Categories | POÈME Owner Console</title>

    <link rel="stylesheet" href="/css/output.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body class="min-h-screen bg-[#0B1120] text-white">
    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->

    <%- include("partials/sidebar.ejs") %>

    <!-- ================================================= -->
    <!-- MAIN -->
    <!-- ================================================= -->

    <main class="ml-72 min-h-screen bg-[#0B1120]">
      <!-- ================================================= -->
      <!-- NAVBAR -->
      <!-- ================================================= -->

      <%- include("partials/navbar.ejs") %>

      <!-- ================================================= -->
      <!-- CONTENT -->
      <!-- ================================================= -->

      <section class="p-6 lg:p-8">
        <!-- ================================================= -->
        <!-- PAGE HEADER -->
        <!-- ================================================= -->

        <div
          class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6 mb-8"
        >
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-11 h-11 rounded-2xl bg-[#B68D40]/10 border border-[#B68D40]/20 flex items-center justify-center text-[#B68D40]"
              >
                <i class="fa-solid fa-layer-group"></i>
              </div>

              <span class="text-xs uppercase tracking-[0.28em] text-[#B68D40]">
                Catalog Management
              </span>
            </div>

            <h1 class="text-3xl lg:text-4xl font-semibold tracking-tight">
              Categories
            </h1>

            <p class="mt-3 text-sm lg:text-base text-stone-400 max-w-2xl">
              View all product categories created by sellers across the POÈME
              marketplace.
            </p>
          </div>

          <!-- TOTAL -->

          <div
            class="flex items-center gap-4 rounded-2xl border border-white/10 bg-[#111B38] px-5 py-4"
          >
            <div
              class="w-11 h-11 rounded-xl bg-white/5 flex items-center justify-center text-[#B68D40]"
            >
              <i class="fa-solid fa-layer-group"></i>
            </div>

            <div>
              <p class="text-xs uppercase tracking-wider text-stone-500">
                Total Categories
              </p>

              <p class="text-2xl font-semibold mt-1">
                <%= stats?.total || 0 %>
              </p>
            </div>
          </div>
        </div>

        <!-- ================================================= -->
        <!-- FLASH MESSAGES -->
        <!-- ================================================= -->

        <% if (success && success.length) { %>

        <div
          class="mb-6 rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.05] px-5 py-4 flex items-center gap-3"
        >
          <div
            class="w-9 h-9 rounded-xl bg-emerald-400/10 text-emerald-400 flex items-center justify-center"
          >
            <i class="fa-solid fa-check"></i>
          </div>

          <p class="text-sm text-emerald-300"><%= success[0] %></p>
        </div>

        <% } %>

        <% if (error && error.length) { %>

        <div
          class="mb-6 rounded-2xl border border-red-400/20 bg-red-400/[0.05] px-5 py-4 flex items-center gap-3"
        >
          <div
            class="w-9 h-9 rounded-xl bg-red-400/10 text-red-400 flex items-center justify-center"
          >
            <i class="fa-solid fa-circle-exclamation"></i>
          </div>

          <p class="text-sm text-red-300"><%= error[0] %></p>
        </div>

        <% } %>

        <!-- ================================================= -->
        <!-- STATISTICS -->
        <!-- ================================================= -->

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-7">
          <!-- TOTAL -->

          <div class="rounded-2xl border border-white/10 bg-[#111B38] p-5">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-wider text-stone-500">
                  Total
                </p>

                <p class="text-2xl font-semibold mt-2">
                  <%= stats?.total || 0 %>
                </p>

                <p class="text-xs text-stone-600 mt-1">All categories</p>
              </div>

              <div
                class="w-11 h-11 rounded-xl bg-white/5 flex items-center justify-center text-stone-400"
              >
                <i class="fa-solid fa-layer-group"></i>
              </div>
            </div>
          </div>

          <!-- WITH PRODUCTS -->

          <div
            class="rounded-2xl border border-emerald-400/10 bg-emerald-400/[0.04] p-5"
          >
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-wider text-emerald-300/60">
                  Used Categories
                </p>

                <p class="text-2xl font-semibold text-emerald-300 mt-2">
                  <%= stats?.withProducts || 0 %>
                </p>

                <p class="text-xs text-stone-600 mt-1">Have products</p>
              </div>

              <div
                class="w-11 h-11 rounded-xl bg-emerald-400/10 flex items-center justify-center text-emerald-300"
              >
                <i class="fa-solid fa-box-open"></i>
              </div>
            </div>
          </div>

          <!-- EMPTY -->

          <div
            class="rounded-2xl border border-amber-400/10 bg-amber-400/[0.04] p-5"
          >
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-wider text-amber-300/60">
                  Empty Categories
                </p>

                <p class="text-2xl font-semibold text-amber-300 mt-2">
                  <%= stats?.empty || 0 %>
                </p>

                <p class="text-xs text-stone-600 mt-1">No products assigned</p>
              </div>

              <div
                class="w-11 h-11 rounded-xl bg-amber-400/10 flex items-center justify-center text-amber-300"
              >
                <i class="fa-solid fa-folder-open"></i>
              </div>
            </div>
          </div>

          <!-- PRODUCTS -->

          <div
            class="rounded-2xl border border-indigo-400/10 bg-indigo-400/[0.04] p-5"
          >
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-wider text-indigo-300/60">
                  Assigned Products
                </p>

                <p class="text-2xl font-semibold text-indigo-300 mt-2">
                  <%= stats?.products || 0 %>
                </p>

                <p class="text-xs text-stone-600 mt-1">Across all categories</p>
              </div>

              <div
                class="w-11 h-11 rounded-xl bg-indigo-400/10 flex items-center justify-center text-indigo-300"
              >
                <i class="fa-solid fa-boxes-stacked"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- ================================================= -->
        <!-- SEARCH -->
        <!-- ================================================= -->

        <div
          class="rounded-2xl border border-white/10 bg-[#111B38] p-4 lg:p-5 mb-7"
        >
          <form
            method="GET"
            action="/poeme-perfumery/admin/categories"
            class="flex flex-col md:flex-row gap-3"
          >
            <div class="relative flex-1">
              <i
                class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-stone-500"
              ></i>

              <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                placeholder="Search category, slug or seller..."
                class="w-full h-12 rounded-xl border border-white/10 bg-[#0B1120] pl-11 pr-4 text-sm text-white placeholder:text-stone-600 outline-none focus:border-[#B68D40] transition"
              />
            </div>

            <button
              type="submit"
              class="h-12 px-6 rounded-xl bg-[#B68D40] text-[#0B1120] font-semibold hover:bg-[#c99f53] transition"
            >
              <i class="fa-solid fa-magnifying-glass mr-2"></i>

              Search
            </button>

            <% if (search) { %>

            <a
              href="/poeme-perfumery/admin/categories"
              class="h-12 w-12 rounded-xl border border-white/10 bg-white/5 flex items-center justify-center text-stone-400 hover:text-white hover:bg-white/10 transition"
              title="Clear search"
            >
              <i class="fa-solid fa-rotate-left"></i>
            </a>

            <% } %>
          </form>
        </div>

        <!-- ================================================= -->
        <!-- RESULT HEADER -->
        <!-- ================================================= -->

        <div
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5"
        >
          <div>
            <h2 class="text-lg font-semibold">Marketplace Categories</h2>

            <p class="text-sm text-stone-500 mt-1">
              Read-only overview of seller-created categories.
            </p>
          </div>

          <span class="text-sm text-stone-500">
            <%= categories?.length || 0 %> categories shown
          </span>
        </div>

        <!-- ================================================= -->
        <!-- CATEGORY GRID -->
        <!-- ================================================= -->

        <% if (!categories || categories.length === 0) { %>

        <!-- EMPTY -->

        <div
          class="rounded-[26px] border border-white/10 bg-[#111B38] px-6 py-24 text-center"
        >
          <div
            class="mx-auto w-20 h-20 rounded-3xl bg-white/5 flex items-center justify-center text-stone-600 text-3xl"
          >
            <i class="fa-solid fa-folder-open"></i>
          </div>

          <h3 class="mt-6 text-xl font-semibold">No categories found</h3>

          <% if (search) { %>

          <p class="mt-2 text-sm text-stone-500">
            No categories matched "<%= search %>".
          </p>

          <a
            href="/poeme-perfumery/admin/categories"
            class="inline-flex items-center gap-2 mt-6 px-5 py-3 rounded-xl border border-white/10 bg-white/5 text-sm text-stone-300 hover:text-white hover:bg-white/10 transition"
          >
            <i class="fa-solid fa-rotate-left"></i>

            Clear Search
          </a>

          <% } else { %>

          <p class="mt-2 text-sm text-stone-500">
            No categories have been created yet.
          </p>

          <% } %>
        </div>

        <% } else { %>

        <!-- ================================================= -->
        <!-- CARDS -->
        <!-- ================================================= -->

        <div
          class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-5"
        >
          <% categories.forEach((category, index) => { %>

          <article
            class="group rounded-[24px] border border-white/10 bg-[#111B38] p-5 hover:border-[#B68D40]/30 hover:shadow-2xl hover:shadow-black/20 transition duration-300"
          >
            <!-- TOP -->

            <div class="flex items-start justify-between gap-4">
              <div
                class="w-12 h-12 rounded-2xl bg-[#B68D40]/10 border border-[#B68D40]/20 flex items-center justify-center text-[#B68D40]"
              >
                <i class="fa-solid fa-layer-group"></i>
              </div>

              <span
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#B68D40]/10 border border-[#B68D40]/20 text-[#B68D40] text-[10px] uppercase tracking-wider font-medium"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-[#B68D40]"></span>

                Catalog
              </span>
            </div>

            <!-- CATEGORY NAME -->

            <div class="mt-5">
              <h3
                class="text-lg font-semibold text-white line-clamp-2 min-h-[56px]"
                title="<%= category.categoryName %>"
              >
                <%= category.categoryName %>
              </h3>

              <p
                class="mt-2 text-xs text-stone-500 break-all"
                title="<%= category.slug %>"
              >
                /<%= category.slug %>
              </p>
            </div>

            <!-- SELLER -->

            <div class="mt-5 pt-4 border-t border-white/5">
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 rounded-xl bg-[#B68D40]/10 flex items-center justify-center text-[#B68D40]"
                >
                  <i class="fa-solid fa-store"></i>
                </div>

                <div class="min-w-0 flex-1">
                  <p
                    class="text-[10px] uppercase tracking-wider text-stone-600"
                  >
                    Created By
                  </p>

                  <p
                    class="text-sm text-stone-200 truncate mt-1"
                    title="<%= category.seller?.name || '' %>"
                  >
                    <%= category.seller?.name || "Unknown Seller" %>
                  </p>

                  <% if (category.seller?.email) { %>

                  <p
                    class="text-[11px] text-stone-600 truncate mt-0.5"
                    title="<%= category.seller.email %>"
                  >
                    <%= category.seller.email %>
                  </p>

                  <% } %>
                </div>
              </div>
            </div>

            <!-- PRODUCT COUNT -->

            <div class="grid grid-cols-2 gap-3 mt-4">
              <div class="rounded-xl bg-[#0B1120] border border-white/5 p-3">
                <p class="text-[10px] uppercase tracking-wider text-stone-600">
                  Products
                </p>

                <p class="text-lg font-semibold text-white mt-1">
                  <%= category.productCount || 0 %>
                </p>

                <% if ((category.productCount || 0) > 0) { %>

                <p class="text-[10px] text-emerald-400 mt-0.5">In use</p>

                <% } else { %>

                <p class="text-[10px] text-stone-600 mt-0.5">No products</p>

                <% } %>
              </div>

              <div class="rounded-xl bg-[#0B1120] border border-white/5 p-3">
                <p class="text-[10px] uppercase tracking-wider text-stone-600">
                  Created
                </p>

                <p class="text-sm font-semibold text-white mt-2">
                  <%= category.createdAt
                                            ? new Date(category.createdAt).toLocaleDateString(
                                                "en-IN",
                                                {
                                                    day: "2-digit",
                                                    month: "short",
                                                    year: "numeric"
                                                }
                                            )
                                            : "N/A"
                                        %>
                </p>
              </div>
            </div>

            <!-- FOOTER -->

            <div
              class="flex items-center justify-between mt-5 pt-4 border-t border-white/5"
            >
              <div class="flex items-center gap-2 text-[11px] text-stone-600">
                <i class="fa-solid fa-shield-halved"></i>

                Read only
              </div>

              <span class="text-[11px] text-stone-600">
                #<%= index + 1 + ((pagination.currentPage - 1) * 12) %>
              </span>
            </div>
          </article>

          <% }) %>
        </div>

        <!-- ================================================= -->
        <!-- PAGINATION -->
        <!-- ================================================= -->

        <% if (pagination && pagination.totalPages > 1) { %>

        <div
          class="mt-8 rounded-2xl border border-white/10 bg-[#111B38] px-5 py-4 flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <p class="text-sm text-stone-500">
            Showing

            <span class="text-stone-300"> <%= pagination.start %> </span>

            -

            <span class="text-stone-300"> <%= pagination.end %> </span>

            of

            <span class="text-stone-300"> <%= pagination.total %> </span>
          </p>

          <div class="flex items-center gap-2">
            <!-- PREVIOUS -->

            <% if (pagination.currentPage > 1) { %>

            <a
              href="?page=<%= pagination.currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>"
              class="w-10 h-10 rounded-xl border border-white/10 bg-white/5 flex items-center justify-center text-stone-400 hover:text-white hover:bg-white/10 transition"
            >
              <i class="fa-solid fa-chevron-left"></i>
            </a>

            <% } else { %>

            <span
              class="w-10 h-10 rounded-xl border border-white/5 bg-white/[0.02] flex items-center justify-center text-stone-700"
            >
              <i class="fa-solid fa-chevron-left"></i>
            </span>

            <% } %>

            <!-- CURRENT PAGE -->

            <div
              class="h-10 min-w-10 px-3 rounded-xl bg-[#B68D40] text-[#0B1120] flex items-center justify-center text-sm font-semibold"
            >
              <%= pagination.currentPage %>
            </div>

            <!-- NEXT -->

            <% if (pagination.currentPage < pagination.totalPages) { %>

            <a
              href="?page=<%= pagination.currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>"
              class="w-10 h-10 rounded-xl border border-white/10 bg-white/5 flex items-center justify-center text-stone-400 hover:text-white hover:bg-white/10 transition"
            >
              <i class="fa-solid fa-chevron-right"></i>
            </a>

            <% } else { %>

            <span
              class="w-10 h-10 rounded-xl border border-white/5 bg-white/[0.02] flex items-center justify-center text-stone-700"
            >
              <i class="fa-solid fa-chevron-right"></i>
            </span>

            <% } %>
          </div>
        </div>

        <% } %>

        <% } %>
      </section>
    </main>
  </body>
</html>
