<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Sellers | POÈME Perfumery</title>

    <link rel="stylesheet" href="/css/output.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body class="min-h-screen bg-[#0B1120] text-white">
    <!-- ===================================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================================== -->

    <%- include("partials/sidebar.ejs") %>

    <!-- ===================================================== -->
    <!-- MAIN -->
    <!-- ===================================================== -->

    <main class="ml-72 min-h-screen bg-[#0B1120]">
      <!-- ================================================= -->
      <!-- NAVBAR -->
      <!-- ================================================= -->

      <%- include("partials/navbar.ejs") %>

      <!-- ================================================= -->
      <!-- CONTENT -->
      <!-- ================================================= -->

      <section class="p-6 lg:p-8">
        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <div
          class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6 mb-8"
        >
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-11 h-11 rounded-2xl bg-[#B68D40]/10 border border-[#B68D40]/20 flex items-center justify-center text-[#B68D40]"
              >
                <i class="fa-solid fa-store"></i>
              </div>

              <span class="text-xs uppercase tracking-[0.28em] text-[#B68D40]">
                Seller Management
              </span>
            </div>

            <h1 class="text-3xl lg:text-4xl font-semibold tracking-tight">
              Sellers
            </h1>

            <p class="mt-3 text-sm lg:text-base text-stone-400 max-w-2xl">
              View every seller registered in your marketplace, monitor their
              account status and manage seller access.
            </p>
          </div>

          <!-- TOTAL SELLERS -->

          <div
            class="flex items-center gap-4 px-5 py-4 rounded-2xl bg-[#111B38] border border-white/10"
          >
            <div
              class="w-11 h-11 rounded-xl bg-[#B68D40]/10 text-[#B68D40] flex items-center justify-center"
            >
              <i class="fa-solid fa-store"></i>
            </div>

            <div>
              <p class="text-xs uppercase tracking-wider text-stone-500">
                Total Sellers
              </p>

              <p class="text-2xl font-semibold mt-1">
                <%= pagination && pagination.total ? pagination.total : 0 %>
              </p>
            </div>
          </div>
        </div>

        <!-- ================================================= -->
        <!-- SEARCH -->
        <!-- ================================================= -->

        <div class="mb-8 rounded-3xl bg-[#111B38] border border-white/10 p-5">
          <form
            method="GET"
            action="/poeme-perfumery/admin/sellers"
            class="flex flex-col lg:flex-row gap-4"
          >
            <div class="relative flex-1">
              <i
                class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-stone-500"
              ></i>

              <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                placeholder="Search seller by name, email or phone..."
                class="w-full h-12 rounded-2xl bg-[#0B1120] border border-white/10 pl-11 pr-4 text-sm text-white placeholder:text-stone-600 outline-none focus:border-[#B68D40] transition"
              />
            </div>

            <button
              type="submit"
              class="h-12 px-7 rounded-2xl bg-[#B68D40] text-[#0B1120] font-semibold hover:bg-[#c99f53] transition"
            >
              <i class="fa-solid fa-magnifying-glass mr-2"></i>

              Search
            </button>

            <% if (search) { %>

            <a
              href="/poeme-perfumery/admin/sellers"
              class="h-12 px-7 rounded-2xl border border-white/10 text-stone-300 hover:bg-white/5 hover:text-white transition flex items-center justify-center"
            >
              <i class="fa-solid fa-xmark mr-2"></i>

              Clear
            </a>

            <% } %>
          </form>
        </div>

        <!-- ================================================= -->
        <!-- SECTION HEADER -->
        <!-- ================================================= -->

        <div
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6"
        >
          <div>
            <h2 class="text-xl font-semibold">All Sellers</h2>

            <p class="text-sm text-stone-500 mt-1">
              Seller accounts currently registered in the database
            </p>
          </div>

          <div class="flex items-center gap-2 text-sm text-stone-500">
            <i class="fa-solid fa-shield-halved"></i>

            Admin control
          </div>
        </div>

        <!-- ================================================= -->
        <!-- FLASH MESSAGES -->
        <!-- ================================================= -->

        <% if (success && success.length) { %>

        <div
          class="mb-6 rounded-2xl border border-emerald-400/20 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-300"
        >
          <i class="fa-solid fa-circle-check mr-2"></i>

          <%= success[0] %>
        </div>

        <% } %>

        <% if (error && error.length) { %>

        <div
          class="mb-6 rounded-2xl border border-red-400/20 bg-red-400/10 px-5 py-4 text-sm text-red-300"
        >
          <i class="fa-solid fa-circle-exclamation mr-2"></i>

          <%= error[0] %>
        </div>

        <% } %>

        <!-- ================================================= -->
        <!-- SELLER CARDS -->
        <!-- ================================================= -->

        <% if (sellers && sellers.length > 0) { %>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          <% sellers.forEach(function(seller, index) { %>

          <div
            class="rounded-3xl bg-[#111B38] border border-white/10 overflow-hidden hover:border-[#B68D40]/30 transition duration-300"
          >
            <!-- ================================= -->
            <!-- SELLER TOP -->
            <!-- ================================= -->

            <div class="p-6">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-4 min-w-0">
                  <div
                    class="w-14 h-14 shrink-0 rounded-2xl bg-[#B68D40]/10 border border-[#B68D40]/20 text-[#B68D40] flex items-center justify-center"
                  >
                    <i class="fa-solid fa-store text-xl"></i>
                  </div>

                  <div class="min-w-0">
                    <h3 class="font-semibold text-lg truncate">
                      <%= seller.name || "Seller" %>
                    </h3>

                    <p class="text-sm text-stone-500 mt-1">Seller account</p>
                  </div>
                </div>

                <!-- STATUS -->

                <% if (seller.isActive !== false) { %>

                <span
                  class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-400/10 text-emerald-300 text-xs font-medium"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>

                  Active
                </span>

                <% } else { %>

                <span
                  class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-400/10 text-red-300 text-xs font-medium"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>

                  Deleted
                </span>

                <% } %>
              </div>

              <!-- ================================= -->
              <!-- CONTACT -->
              <!-- ================================= -->

              <div class="mt-6 space-y-3">
                <div class="flex items-center gap-3">
                  <div
                    class="w-9 h-9 shrink-0 rounded-xl bg-white/5 flex items-center justify-center text-stone-500"
                  >
                    <i class="fa-solid fa-envelope"></i>
                  </div>

                  <div class="min-w-0">
                    <p class="text-xs text-stone-600">Email</p>

                    <p class="text-sm text-stone-300 truncate">
                      <%= seller.email || "Not available" %>
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-3">
                  <div
                    class="w-9 h-9 shrink-0 rounded-xl bg-white/5 flex items-center justify-center text-stone-500"
                  >
                    <i class="fa-solid fa-phone"></i>
                  </div>

                  <div>
                    <p class="text-xs text-stone-600">Phone</p>

                    <p class="text-sm text-stone-300">
                      <%= seller.phone || "Not available" %>
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- ================================= -->
            <!-- SELLER STATISTICS -->
            <!-- ================================= -->

            <div class="px-6 py-5 border-t border-white/10 bg-[#0B1120]/40">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <p class="text-xs uppercase tracking-wider text-stone-600">
                    Products
                  </p>

                  <p class="text-xl font-semibold mt-1">
                    <%= seller.totalProducts || 0 %>
                  </p>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-wider text-stone-600">
                    Active
                  </p>

                  <p class="text-xl font-semibold mt-1 text-emerald-400">
                    <%= seller.activeProducts || 0 %>
                  </p>
                </div>
              </div>

              <!-- ================================= -->
              <!-- VERIFICATION -->
              <!-- ================================= -->

              <div
                class="mt-5 pt-5 border-t border-white/5 flex items-center justify-between"
              >
                <span class="text-xs text-stone-500"> Verification </span>

                <% if (seller.isVerified) { %>

                <span class="text-xs font-medium text-emerald-300">
                  <i class="fa-solid fa-circle-check mr-1"></i>

                  Verified
                </span>

                <% } else { %>

                <span class="text-xs font-medium text-[#B68D40]">
                  <i class="fa-solid fa-clock mr-1"></i>

                  Pending
                </span>

                <% } %>
              </div>
            </div>

            <!-- ================================= -->
            <!-- ACTION -->
            <!-- ================================= -->

            <div class="px-6 py-5 border-t border-white/10">
              <% if (seller.isActive !== false) { %>

              <form
                method="POST"
                action="/poeme-perfumery/admin/sellers/<%= seller._id %>/delete"
                onsubmit="
                  return confirm(
                    'Are you sure you want to delete this seller? The seller account will be deactivated and existing orders/products will be preserved.'
                  );
                "
              >
                <button
                  type="submit"
                  class="w-full h-11 rounded-xl border border-red-400/20 bg-red-400/5 text-red-300 hover:bg-red-400/10 transition font-medium text-sm"
                >
                  <i class="fa-solid fa-trash-can mr-2"></i>

                  Delete Seller
                </button>
              </form>

              <% } else { %>

              <div
                class="w-full h-11 rounded-xl bg-white/5 text-stone-600 flex items-center justify-center text-sm"
              >
                <i class="fa-solid fa-ban mr-2"></i>

                Seller Deleted
              </div>

              <% } %>
            </div>
          </div>

          <% }); %>
        </div>

        <% } else { %>

        <!-- ================================================= -->
        <!-- EMPTY STATE -->
        <!-- ================================================= -->

        <div
          class="rounded-3xl bg-[#111B38] border border-white/10 py-20 px-6 text-center"
        >
          <div
            class="mx-auto w-16 h-16 rounded-2xl bg-[#B68D40]/10 border border-[#B68D40]/20 text-[#B68D40] flex items-center justify-center text-2xl"
          >
            <i class="fa-solid fa-store"></i>
          </div>

          <h3 class="text-xl font-semibold mt-5">No sellers found</h3>

          <p class="mt-2 text-sm text-stone-500 max-w-md mx-auto">
            <% if (search) { %> No sellers matched "<%= search %>". <% } else {
            %> There are currently no seller accounts in the database. <% } %>
          </p>

          <% if (search) { %>

          <a
            href="/poeme-perfumery/admin/sellers"
            class="inline-flex items-center gap-2 mt-6 px-5 py-3 rounded-xl bg-[#B68D40] text-[#0B1120] font-semibold hover:bg-[#c99f53] transition"
          >
            <i class="fa-solid fa-arrow-left"></i>

            View All Sellers
          </a>

          <% } %>
        </div>

        <% } %>

        <!-- ================================================= -->
        <!-- PAGINATION -->
        <!-- ================================================= -->

        <% if ( pagination && pagination.totalPages && pagination.totalPages > 1
        ) { %>

        <div
          class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <p class="text-sm text-stone-500">
            Showing

            <span class="text-stone-300 font-medium">
              <%= pagination.start %>
            </span>

            -

            <span class="text-stone-300 font-medium">
              <%= pagination.end %>
            </span>

            of

            <span class="text-stone-300 font-medium">
              <%= pagination.total %>
            </span>

            sellers
          </p>

          <div class="flex items-center gap-2">
            <% if (pagination.currentPage > 1) { %>

            <a
              href="/poeme-perfumery/admin/sellers?page=<%= pagination.currentPage - 1 %>&search=<%= search || '' %>"
              class="w-10 h-10 rounded-xl border border-white/10 bg-[#111B38] flex items-center justify-center text-stone-400 hover:text-white hover:border-[#B68D40]/30 transition"
            >
              <i class="fa-solid fa-chevron-left"></i>
            </a>

            <% } else { %>

            <span
              class="w-10 h-10 rounded-xl border border-white/5 bg-[#111B38]/50 flex items-center justify-center text-stone-700"
            >
              <i class="fa-solid fa-chevron-left"></i>
            </span>

            <% } %>

            <div
              class="px-4 h-10 rounded-xl bg-[#B68D40] text-[#0B1120] flex items-center justify-center font-semibold text-sm"
            >
              <%= pagination.currentPage %>

              /

              <%= pagination.totalPages %>
            </div>

            <% if (
                            pagination.currentPage <
                            pagination.totalPages
                        ) { %>

            <a
              href="/poeme-perfumery/admin/sellers?page=<%= pagination.currentPage + 1 %>&search=<%= search || '' %>"
              class="w-10 h-10 rounded-xl border border-white/10 bg-[#111B38] flex items-center justify-center text-stone-400 hover:text-white hover:border-[#B68D40]/30 transition"
            >
              <i class="fa-solid fa-chevron-right"></i>
            </a>

            <% } else { %>

            <span
              class="w-10 h-10 rounded-xl border border-white/5 bg-[#111B38]/50 flex items-center justify-center text-stone-700"
            >
              <i class="fa-solid fa-chevron-right"></i>
            </span>

            <% } %>
          </div>
        </div>

        <% } %>
      </section>
    </main>
  </body>
</html>
