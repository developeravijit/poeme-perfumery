<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart | POÈME Perfumery</title>

    <link rel="stylesheet" href="/css/output.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#FCFBF8]">
    <%- include("layout/navbar.ejs") %>

    <section class="max-w-7xl mx-auto px-6 py-20">
      <div class="text-center mb-14">
        <p class="uppercase tracking-[8px] text-[#B68D40] font-semibold">
          Shopping Cart
        </p>

        <h1 class="text-5xl font-bold text-stone-900 mt-4">
          Your Luxury Collection
        </h1>

        <p class="text-stone-500 mt-4">
          Review your selected fragrances before checkout.
        </p>
      </div>

      <% if(cartItems.length){ %>

      <div class="grid lg:grid-cols-3 gap-10">
        <!-- Cart Items -->
        <div class="lg:col-span-2 space-y-8">
          <% cartItems.forEach(item=>{ %>

          <div
            class="bg-white rounded-3xl border border-stone-200 shadow-lg p-6 flex flex-col md:flex-row gap-6"
          >
            <!-- Image -->
            <div
              class="w-full md:w-52 h-52 rounded-2xl bg-[#F8F6F2] overflow-hidden"
            >
              <% if(item.product.images && item.product.images.length){ %>

              <img
                src="<%= item.product.images[0].url %>"
                alt="<%= item.product.productName %>"
                class="w-full h-full object-cover"
              />

              <% } else { %>

              <div
                class="w-full h-full flex items-center justify-center text-5xl text-stone-300"
              >
                <i class="fa-solid fa-image"></i>
              </div>

              <% } %>
            </div>

            <!-- Details -->
            <div class="flex-1">
              <h2 class="text-3xl font-bold text-stone-900">
                <%= item.product.productName %>
              </h2>

              <p class="text-stone-500 mt-2">
                <%= item.category.categoryName %>
              </p>

              <p class="text-stone-500 mt-1">
                Brand :
                <span class="font-medium">
                  <%= item.product.brand || "POÈME" %>
                </span>
              </p>

              <div
                class="flex flex-col md:flex-row md:justify-between md:items-center mt-8 gap-6"
              >
                <!-- Quantity -->
                <div class="flex items-center border rounded-full">
                  <a
                    href="/poeme-perfumery/cart/decrease/<%= item.product._id %>"
                    class="px-5 py-2 text-xl hover:bg-stone-100 rounded-l-full"
                  >
                    -
                  </a>

                  <span class="px-6 font-semibold"> <%= item.quantity %> </span>

                  <a
                    href="/poeme-perfumery/cart/increase/<%= item.product._id %>"
                    class="px-5 py-2 text-xl hover:bg-stone-100 rounded-r-full"
                  >
                    +
                  </a>
                </div>

                <a
                  href="/poeme-perfumery/cart/remove/<%= item.product._id %>"
                  class="text-red-600 hover:text-red-700"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="1.5em"
                    height="1.5em"
                    viewBox="0 0 36 36"
                  >
                    <path
                      fill="currentColor"
                      d="m19.61 18l4.86-4.86a1 1 0 0 0-1.41-1.41l-4.86 4.81l-4.89-4.89a1 1 0 0 0-1.41 1.41L16.78 18L12 22.72a1 1 0 1 0 1.41 1.41l4.77-4.77l4.74 4.74a1 1 0 0 0 1.41-1.41Z"
                      className="clr-i-outline clr-i-outline-path-1"
                    ></path>
                    <path
                      fill="currentColor"
                      d="M18 34a16 16 0 1 1 16-16a16 16 0 0 1-16 16m0-30a14 14 0 1 0 14 14A14 14 0 0 0 18 4"
                      className="clr-i-outline clr-i-outline-path-2"
                    ></path>
                    <path fill="none" d="M0 0h36v36H0z"></path>
                  </svg>
                </a>

                <!-- Price -->
                <div class="text-right">
                  <p class="text-stone-500">
                    ₹ <%= item.product.price.toLocaleString("en-IN") %> × <%=
                    item.quantity %>
                  </p>

                  <h3 class="text-3xl font-bold text-[#B68D40]">
                    ₹ <%= item.totalPrice.toLocaleString("en-IN") %>
                  </h3>
                </div>
              </div>
            </div>

            <!-- Remove -->
            <div>
              <a
                href="/poeme-perfumery/cart/remove/<%= item.product._id %>"
                class="text-red-600 hover:text-red-700"
              >
                <i class="fa-solid fa-trash"></i>
              </a>
            </div>
          </div>

          <% }) %>
        </div>

        <!-- Summary -->

        <div>
          <div
            class="bg-white rounded-3xl border border-stone-200 shadow-lg p-8 sticky top-24"
          >
            <h2 class="text-3xl font-bold mb-8">Order Summary</h2>

            <div class="space-y-5">
              <div class="flex justify-between">
                <span>Subtotal</span>
                <span
                  >₹
                  <%= subtotal.toLocaleString("en-IN") %></span
                >
              </div>

              <div class="flex justify-between">
                <span>Shipping</span>
                <span
                  >₹
                  <%= shipping.toLocaleString("en-IN") %></span
                >
              </div>

              <div class="flex justify-between">
                <span>Tax (18%)</span>
                <span
                  >₹
                  <%= tax.toLocaleString("en-IN") %></span
                >
              </div>

              <hr />

              <div class="flex justify-between text-2xl font-bold">
                <span>Total</span>

                <span class="text-[#B68D40]">
                  ₹ <%= total.toLocaleString("en-IN") %>
                </span>
              </div>
            </div>

            <button
              id="payBtn"
              class="block w-full mt-10 bg-[#B68D40] hover:bg-[#9A7737] text-white text-center py-4 rounded-full font-semibold"
            >
              Pay Now
            </button>

            <a
              href="/poeme-perfumery/perfumes"
              class="block mt-4 border border-[#B68D40] text-[#B68D40] text-center py-4 rounded-full"
            >
              Continue Shopping
            </a>
          </div>
        </div>
      </div>

      <% } else { %>

      <div class="bg-white rounded-3xl shadow-lg p-20 text-center">
        <div class="text-8xl text-[#B68D40]">
          <i class="fa-solid fa-cart-shopping"></i>
        </div>

        <h2 class="text-4xl font-bold mt-8">Your Cart is Empty</h2>

        <p class="text-stone-500 mt-4">
          Add your favourite fragrances to start shopping.
        </p>

        <a
          href="/poeme-perfumery/perfumes"
          class="inline-block mt-10 bg-[#B68D40] hover:bg-[#9A7737] text-white px-10 py-4 rounded-full"
        >
          Shop Now
        </a>
      </div>

      <% } %>
    </section>

    <%- include("layout/footer.ejs") %>

    <script src="/js/index.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
      (function(){
        const payBtn = document.getElementById("payBtn");
        if (!payBtn) return;

        payBtn.addEventListener("click", async function (e) {
          e.preventDefault();

          try {
            const resp = await fetch("/api/v1/payment/create-order", {
              method: "POST",
              credentials: "same-origin",
              headers: { "Content-Type": "application/json" },
            });

            const data = await resp.json();

            if (!data || !data.success) {
              alert(data.message || "Unable to create order");
              return;
            }

            const options = {
              key: data.key,
              amount: data.amount,
              currency: data.currency,
              name: "POÈME Perfumery",
              description: "Order Payment",
              order_id: data.orderId,
              handler: async function (razorResp) {
                try {
                  const verify = await fetch("/api/v1/payment/verify-payment", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      razorpay_payment_id: razorResp.razorpay_payment_id,
                      razorpay_order_id: razorResp.razorpay_order_id,
                      razorpay_signature: razorResp.razorpay_signature,
                      dbOrderId: data.dbOrderId,
                    }),
                  });

                  const vdata = await verify.json();
                  if (vdata.success) {
                    window.location.href = "/poeme-perfumery/orders";
                  } else {
                    alert(vdata.message || "Payment verification failed");
                  }
                } catch (err) {
                  console.error(err);
                  alert("Verification error");
                }
              },
              prefill: {
                name: "<%= user ? user.name : "" %>",
                email: "<%= user ? user.email : "" %>",
                contact: "<%= user ? user.phone || "" : "" %>",
              },
              theme: { color: "#B68D40" },
            };

            const rzp = new Razorpay(options);
            rzp.open();
          } catch (error) {
            console.error(error);
            alert("Payment initiation failed");
          }
        });
      })();
    </script>
  </body>
</html>
