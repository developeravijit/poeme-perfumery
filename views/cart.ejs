<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Shopping Cart | POÈME Perfumery
  </title>


  <!-- Main Tailwind CSS -->

  <link
    rel="stylesheet"
    href="/css/output.css"
  >


  <!-- Google Fonts -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >

</head>


<body class="bg-[#FCFBF8]">


  <!-- ================================================= -->
  <!-- NAVBAR -->
  <!-- ================================================= -->

  <%- include("layout/navbar.ejs") %>



  <!-- ================================================= -->
  <!-- CART -->
  <!-- ================================================= -->

  <section
    class="max-w-7xl mx-auto px-6 py-20"
  >


    <!-- ================================================= -->
    <!-- PAGE HEADER -->
    <!-- ================================================= -->

    <div
      class="text-center mb-14"
    >

      <p
        class="uppercase tracking-[8px] text-[#B68D40] font-semibold"
      >
        Shopping Cart
      </p>


      <h1
        class="text-5xl font-bold text-stone-900 mt-4"
      >
        Your Luxury Collection
      </h1>


      <p
        class="text-stone-500 mt-4"
      >
        Review your selected fragrances and
        complete your delivery details.
      </p>

    </div>



    <% if (cartItems.length) { %>


    <!-- ================================================= -->
    <!-- MAIN GRID -->
    <!-- ================================================= -->

    <div
      class="grid lg:grid-cols-3 gap-10"
    >


      <!-- ================================================= -->
      <!-- CART PRODUCTS -->
      <!-- ================================================= -->

      <div
        class="lg:col-span-2 space-y-8"
      >


        <% cartItems.forEach(item => { %>


        <!-- PRODUCT CARD -->

        <div
          class="bg-white rounded-3xl border border-stone-200 shadow-lg p-6 flex flex-col md:flex-row gap-6"
        >


          <!-- PRODUCT IMAGE -->

          <div
            class="w-full md:w-52 h-52 rounded-2xl bg-[#F8F6F2] overflow-hidden flex-shrink-0"
          >

            <% if (
              item.product.images &&
              item.product.images.length
            ) { %>

              <img
                src="<%= item.product.images[0].url %>"
                alt="<%= item.product.productName %>"
                class="w-full h-full object-cover"
              >

            <% } else { %>

              <div
                class="w-full h-full flex items-center justify-center text-5xl text-stone-300"
              >

                <i
                  class="fa-solid fa-image"
                ></i>

              </div>

            <% } %>

          </div>



          <!-- PRODUCT DETAILS -->

          <div
            class="flex-1"
          >

            <h2
              class="text-3xl font-bold text-stone-900"
            >
              <%= item.product.productName %>
            </h2>


            <p
              class="text-stone-500 mt-2"
            >
              <%= item.category.categoryName %>
            </p>


            <p
              class="text-stone-500 mt-1"
            >

              Brand:

              <span
                class="font-medium"
              >
                <%= item.product.brand || "POÈME" %>
              </span>

            </p>



            <!-- PRICE / QUANTITY -->

            <div
              class="flex flex-col md:flex-row md:justify-between md:items-center mt-8 gap-6"
            >


              <!-- QUANTITY -->

              <div
                class="flex items-center border border-stone-200 rounded-full w-fit overflow-hidden"
              >

                <a
                  href="/poeme-perfumery/cart/decrease/<%= item.product._id %>"
                  class="px-5 py-2 text-xl hover:bg-stone-100 transition"
                >
                  -
                </a>


                <span
                  class="px-6 py-2 font-semibold"
                >
                  <%= item.quantity %>
                </span>


                <a
                  href="/poeme-perfumery/cart/increase/<%= item.product._id %>"
                  class="px-5 py-2 text-xl hover:bg-stone-100 transition"
                >
                  +
                </a>

              </div>



              <!-- PRICE -->

              <div
                class="text-right"
              >

                <p
                  class="text-stone-500"
                >

                  ₹
                  <%= item.product.price.toLocaleString("en-IN") %>

                  ×

                  <%= item.quantity %>

                </p>


                <h3
                  class="text-3xl font-bold text-[#B68D40]"
                >

                  ₹
                  <%= item.totalPrice.toLocaleString("en-IN") %>

                </h3>

              </div>


            </div>

          </div>



          <!-- REMOVE -->

          <div>

            <a
              href="/poeme-perfumery/cart/remove/<%= item.product._id %>"
              class="cart-remove-btn"
              title="Remove product"
            >

              <i
                class="fa-solid fa-trash"
              ></i>

            </a>

          </div>


        </div>


        <% }) %>


      </div>



      <!-- ================================================= -->
      <!-- CHECKOUT -->
      <!-- ================================================= -->

      <div>


        <div
          class="checkout-card bg-white rounded-3xl border border-stone-200 shadow-lg p-8 sticky top-24"
        >


          <!-- ================================================= -->
          <!-- CHECKOUT HEADER -->
          <!-- ================================================= -->

          <div
            class="checkout-header"
          >

            <div
              class="checkout-header-icon"
            >

              <i
                class="fa-solid fa-bag-shopping"
              ></i>

            </div>


            <div>

              <p
                class="checkout-eyebrow"
              >
                Checkout
              </p>


              <h2
                class="checkout-title"
              >
                Delivery Details
              </h2>


              <p
                class="checkout-description"
              >
                Enter your delivery information
                to continue.
              </p>

            </div>

          </div>



          <!-- ================================================= -->
          <!-- ADDRESS FORM -->
          <!-- ================================================= -->

          <form
            id="addressForm"
          >


            <!-- ================================================= -->
            <!-- SHIPPING ADDRESS -->
            <!-- ================================================= -->

            <div
              class="address-section"
            >


              <!-- SECTION HEADING -->

              <div
                class="address-section-heading"
              >

                <div
                  class="address-section-number"
                >
                  01
                </div>


                <div>

                  <h3>
                    Shipping Address
                  </h3>


                  <p>
                    Where should we deliver your fragrance?
                  </p>

                </div>

              </div>



              <!-- ================================================= -->
              <!-- NAME + PHONE -->
              <!-- ================================================= -->

              <div
                class="address-grid"
              >


                <!-- NAME -->

                <div
                  class="address-field"
                >

                  <label
                    for="addressName"
                  >
                    Full Name
                  </label>


                  <div
                    class="address-input-wrapper"
                  >

                    <span
                      class="address-input-icon"
                    >
                      <i
                        class="fa-regular fa-user"
                      ></i>
                    </span>


                    <input
                      type="text"
                      id="addressName"
                      name="name"
                      value="<%= user ? user.name : "" %>"
                      placeholder="Your full name"
                      autocomplete="name"
                      class="address-input"
                      required
                    >

                  </div>

                </div>



                <!-- PHONE -->

                <div
                  class="address-field"
                >

                  <label
                    for="addressPhone"
                  >
                    Phone Number
                  </label>


                  <div
                    class="address-input-wrapper"
                  >

                    <span
                      class="address-input-icon"
                    >
                      <i
                        class="fa-solid fa-phone"
                      ></i>
                    </span>


                    <input
                      type="tel"
                      id="addressPhone"
                      name="phone"
                      value="<%= user ? user.phone || "" : "" %>"
                      placeholder="10 digit mobile"
                      maxlength="10"
                      inputmode="numeric"
                      autocomplete="tel"
                      class="address-input"
                      required
                    >

                  </div>

                </div>


              </div>



              <!-- ================================================= -->
              <!-- ADDRESS -->
              <!-- ================================================= -->

              <div
                class="address-field"
              >

                <label
                  for="addressLine"
                >
                  Complete Address
                </label>


                <div
                  class="address-input-wrapper address-textarea-wrapper"
                >

                  <span
                    class="address-input-icon address-textarea-icon"
                  >
                    <i
                      class="fa-solid fa-house"
                    ></i>
                  </span>


                  <textarea
                    id="addressLine"
                    name="address"
                    rows="3"
                    placeholder="House no., street, area, landmark"
                    autocomplete="street-address"
                    class="address-input address-textarea"
                    required
                  ></textarea>

                </div>

              </div>



              <!-- ================================================= -->
              <!-- CITY + STATE -->
              <!-- ================================================= -->

              <div
                class="address-grid"
              >


                <!-- CITY -->

                <div
                  class="address-field"
                >

                  <label
                    for="addressCity"
                  >
                    City
                  </label>


                  <div
                    class="address-input-wrapper"
                  >

                    <span
                      class="address-input-icon"
                    >
                      <i
                        class="fa-solid fa-city"
                      ></i>
                    </span>


                    <input
                      type="text"
                      id="addressCity"
                      name="city"
                      placeholder="City"
                      autocomplete="address-level2"
                      class="address-input"
                      required
                    >

                  </div>

                </div>



                <!-- STATE -->

                <div
                  class="address-field"
                >

                  <label
                    for="addressState"
                  >
                    State
                  </label>


                  <div
                    class="address-input-wrapper"
                  >

                    <span
                      class="address-input-icon"
                    >
                      <i
                        class="fa-solid fa-map"
                      ></i>
                    </span>


                    <input
                      type="text"
                      id="addressState"
                      name="state"
                      placeholder="State"
                      autocomplete="address-level1"
                      class="address-input"
                      required
                    >

                  </div>

                </div>


              </div>



              <!-- ================================================= -->
              <!-- PIN CODE -->
              <!-- ================================================= -->

              <div
                class="address-field"
              >

                <label
                  for="addressPincode"
                >
                  PIN Code
                </label>


                <div
                  class="address-input-wrapper"
                >

                  <span
                    class="address-input-icon"
                  >
                    <i
                      class="fa-solid fa-location-dot"
                    ></i>
                  </span>


                  <input
                    type="text"
                    id="addressPincode"
                    name="pincode"
                    placeholder="6 digit PIN code"
                    maxlength="6"
                    inputmode="numeric"
                    autocomplete="postal-code"
                    class="address-input"
                    required
                  >

                </div>

              </div>



              <!-- ================================================= -->
              <!-- SECURITY NOTE -->
              <!-- ================================================= -->

              <div
                class="address-security-note"
              >

                <span>

                  <i
                    class="fa-solid fa-shield-halved"
                  ></i>

                </span>


                <p>
                  Your delivery information is securely
                  used for this order only.
                </p>

              </div>


            </div>



            <!-- ================================================= -->
            <!-- ORDER SUMMARY -->
            <!-- ================================================= -->

            <div
              class="order-summary-section"
            >


              <div
                class="order-summary-heading"
              >

                <div>

                  <p
                    class="order-summary-eyebrow"
                  >
                    Your Order
                  </p>


                  <h3>
                    Order Summary
                  </h3>

                </div>

              </div>



              <!-- SUBTOTAL -->

              <div
                class="order-summary-items"
              >

                <div
                  class="order-summary-row"
                >

                  <span>
                    Subtotal
                  </span>


                  <strong>
                    ₹
                    <%= subtotal.toLocaleString("en-IN") %>
                  </strong>

                </div>



                <!-- SHIPPING -->

                <div
                  class="order-summary-row"
                >

                  <span>
                    Shipping
                  </span>


                  <strong>
                    ₹
                    <%= shipping.toLocaleString("en-IN") %>
                  </strong>

                </div>



                <!-- TAX -->

                <div
                  class="order-summary-row"
                >

                  <span>

                    Tax

                    <small>
                      (18%)
                    </small>

                  </span>


                  <strong>
                    ₹
                    <%= tax.toLocaleString("en-IN") %>
                  </strong>

                </div>

              </div>



              <!-- TOTAL -->

              <div
                class="order-total-row"
              >

                <span>
                  Total
                </span>


                <strong>
                  ₹
                  <%= Math.round(total).toLocaleString("en-IN") %>
                </strong>

              </div>


            </div>



            <!-- ================================================= -->
            <!-- PAYMENT -->
            <!-- ================================================= -->

            <button
              type="submit"
              id="payBtn"
              disabled
              class="payment-button"
            >

              <span>
                Proceed to Secure Payment
              </span>


              <i
                class="fa-solid fa-arrow-right"
              ></i>

            </button>



            <!-- MESSAGE -->

            <p
              id="addressMessage"
              class="address-message message-default"
            >
              Complete your delivery address to continue.
            </p>


          </form>



          <!-- ================================================= -->
          <!-- CONTINUE SHOPPING -->
          <!-- ================================================= -->

          <a
            href="/poeme-perfumery/perfumes"
            class="continue-shopping-button"
          >

            <i
              class="fa-solid fa-arrow-left"
            ></i>

            Continue Shopping

          </a>


        </div>

      </div>


    </div>


    <% } else { %>


    <!-- ================================================= -->
    <!-- EMPTY CART -->
    <!-- ================================================= -->

    <div
      class="bg-white rounded-3xl shadow-lg p-20 text-center"
    >

      <div
        class="text-8xl text-[#B68D40]"
      >

        <i
          class="fa-solid fa-cart-shopping"
        ></i>

      </div>


      <h2
        class="text-4xl font-bold mt-8"
      >
        Your Cart is Empty
      </h2>


      <p
        class="text-stone-500 mt-4"
      >
        Add your favourite fragrances to start shopping.
      </p>


      <a
        href="/poeme-perfumery/perfumes"
        class="inline-block mt-10 bg-[#B68D40] hover:bg-[#9A7737] text-white px-10 py-4 rounded-full"
      >
        Shop Now
      </a>

    </div>


    <% } %>


  </section>



  <!-- ================================================= -->
  <!-- FOOTER -->
  <!-- ================================================= -->

  <%- include("layout/footer.ejs") %>



  <!-- ================================================= -->
  <!-- COMMON JS -->
  <!-- ================================================= -->

  <script
    src="/js/index.js"
  ></script>


  <!-- ================================================= -->
  <!-- RAZORPAY -->
  <!-- ================================================= -->

  <script
    src="https://checkout.razorpay.com/v1/checkout.js"
  ></script>


  <!-- ================================================= -->
  <!-- CART JS -->
  <!-- ================================================= -->

  <script
    src="/js/cart.js"
  ></script>


</body>

</html>