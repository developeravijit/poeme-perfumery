<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
  <div
    class="rounded-2xl bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
  >
    <div class="flex items-center justify-between">
      <div>
        <p class="text-slate-500">Products</p>

        <h2 class="mt-2 text-4xl font-bold"><%= stats.totalProducts %></h2>

        <span class="mt-3 inline-block text-sm text-green-600">
          +12 this month
        </span>
      </div>

      <div class="rounded-2xl bg-indigo-100 p-4">
        <i class="fa-solid fa-box text-3xl text-indigo-600"></i>
      </div>
    </div>
  </div>

  <div
    class="rounded-2xl bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
  >
    <div class="flex items-center justify-between">
      <div>
        <p class="text-slate-500">Orders</p>

        <h2 class="mt-2 text-4xl font-bold"><%= stats.totalOrders %></h2>

        <span class="mt-3 inline-block text-sm text-green-600"> +8% </span>
      </div>

      <div class="rounded-2xl bg-green-100 p-4">
        <i class="fa-solid fa-cart-shopping text-3xl text-green-600"></i>
      </div>
    </div>
  </div>

  <div
    class="rounded-2xl bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
  >
    <div class="flex items-center justify-between">
      <div>
        <p class="text-slate-500">Revenue</p>

        <h2 class="mt-2 text-4xl font-bold">$<%= stats.revenue %></h2>

        <span class="mt-3 inline-block text-sm text-green-600"> +18% </span>
      </div>

      <div class="rounded-2xl bg-yellow-100 p-4">
        <i class="fa-solid fa-dollar-sign text-3xl text-yellow-600"></i>
      </div>
    </div>
  </div>

  <div
    class="rounded-2xl bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
  >
    <div class="flex items-center justify-between">
      <div>
        <p class="text-slate-500">Customers</p>

        <h2 class="mt-2 text-4xl font-bold"><%= stats.customers %></h2>
      </div>

      <div class="rounded-2xl bg-cyan-100 p-4">
        <i class="fa-solid fa-users text-3xl text-cyan-600"></i>
      </div>
    </div>
  </div>

  <div
    class="rounded-2xl bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
  >
    <div class="flex items-center justify-between">
      <div>
        <p class="text-slate-500">Pending Orders</p>

        <h2 class="mt-2 text-4xl font-bold"><%= stats.pendingOrders %></h2>
      </div>

      <div class="rounded-2xl bg-orange-100 p-4">
        <i class="fa-solid fa-clock text-3xl text-orange-600"></i>
      </div>
    </div>
  </div>

  <div
    class="rounded-2xl bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
  >
    <div class="flex items-center justify-between">
      <div>
        <p class="text-slate-500">Low Stock</p>

        <h2 class="mt-2 text-4xl font-bold"><%= stats.lowStock %></h2>
      </div>

      <div class="rounded-2xl bg-red-100 p-4">
        <i class="fa-solid fa-triangle-exclamation text-3xl text-red-600"></i>
      </div>
    </div>
  </div>
</div>
