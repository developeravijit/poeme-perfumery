<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Create Category</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body class="bg-slate-100">
    <%- include("partials/sidebar") %>

    <main class="ml-72 min-h-screen">
      <%- include("partials/navbar") %>

      <section class="p-8">
        <div class="max-w-3xl mx-auto">
          <div class="flex justify-between items-center mb-8">
            <div>
              <h1 class="text-3xl font-bold">Create Category</h1>

              <p class="text-slate-500 mt-2">Create a new product category.</p>
            </div>

            <a
              href="/poeme-perfumery/seller/categories"
              class="bg-slate-200 px-5 py-3 rounded-xl hover:bg-slate-300"
            >
              <i class="fa-solid fa-arrow-left mr-2"></i>

              Back
            </a>
          </div>

          <% if(success.length){ %>

          <div
            class="mb-6 bg-green-100 border border-green-300 text-green-700 p-4 rounded-xl"
          >
            <%= success[0] %>
          </div>

          <% } %>

          <% if(error.length){ %>

          <div
            class="mb-6 bg-red-100 border border-red-300 text-red-700 p-4 rounded-xl"
          >
            <%= error[0] %>
          </div>

          <% } %>

          <div class="bg-white rounded-3xl shadow p-10">
            <form
              action="/poeme-perfumery/seller/create/category"
              method="POST"
              class="space-y-8"
            >
              <div>
                <label class="block mb-2 font-semibold"> Category Name </label>

                <input
                  type="text"
                  name="categoryName"
                  placeholder="Example : Men's Perfume"
                  class="w-full h-14 border border-slate-300 rounded-xl px-4 focus:ring-4 focus:ring-indigo-100 outline-none"
                  required
                />
              </div>

              <div class="flex gap-4">
                <button
                  class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl font-semibold"
                >
                  Create Category
                </button>

                <a
                  href="/poeme-perfumery/seller/categories"
                  class="bg-slate-200 hover:bg-slate-300 px-8 py-3 rounded-xl"
                >
                  Cancel
                </a>
              </div>
            </form>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
