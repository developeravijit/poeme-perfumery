<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Products</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body class="bg-slate-100">
    <%- include("partials/sidebar.ejs") %>

    <main class="ml-72 min-h-screen">
      <%- include("partials/navbar.ejs") %>

      <section class="p-8">
        <!-- Header -->

        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-slate-800">All Products</h1>

            <p class="text-slate-500 mt-2">
              Manage your products from one place.
            </p>
          </div>

          <div class="flex items-center gap-3">
            <!-- Deleted Products -->

            <a
              href="/poeme-perfumery/seller/deleted-products"
              class="bg-red-600 hover:bg-red-700 text-white px-5 py-3 rounded-xl font-semibold"
            >
              <i class="fa-solid fa-trash-can mr-2"></i>
              Deleted Products
            </a>

            <!-- Bulk Upload -->

            <a
              href="/poeme-perfumery/seller/bulk-upload"
              class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-3 rounded-xl font-semibold"
            >
              <i class="fa-solid fa-file-arrow-up mr-2"></i>
              Bulk Upload
            </a>

            <!-- Create Product -->

            <a
              href="/poeme-perfumery/seller/create/product"
              class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-xl font-semibold"
            >
              <i class="fa-solid fa-plus mr-2"></i>
              Create Product
            </a>
          </div>
        </div>

        <!-- Flash Messages -->

        <% if(success.length){ %>

        <div
          class="mt-6 bg-green-100 border border-green-300 text-green-700 rounded-xl p-4"
        >
          <%= success[0] %>
        </div>

        <% } %>

        <% if(error.length){ %>

        <div
          class="mt-6 bg-red-100 border border-red-300 text-red-700 rounded-xl p-4"
        >
          <%= error[0] %>
        </div>

        <% } %>

        <!-- Stats -->

        <div class="grid grid-cols-4 gap-6 mt-8">
          <!-- Total Products -->

          <div class="bg-white rounded-2xl p-6 shadow">
            <p class="text-slate-500">Products</p>

            <h2 class="text-4xl font-bold mt-2"><%= products.length %></h2>
          </div>

          <!-- Approved -->

          <div class="bg-white rounded-2xl p-6 shadow">
            <p class="text-slate-500">Approved</p>

            <h2 class="text-4xl font-bold mt-2 text-green-600">
              <%= products.filter(p => p.approvalStatus === "approved").length
              %>
            </h2>
          </div>

          <!-- Pending -->

          <div class="bg-white rounded-2xl p-6 shadow">
            <p class="text-slate-500">Pending</p>

            <h2 class="text-4xl font-bold mt-2 text-yellow-600">
              <%= products.filter(p => p.approvalStatus === "pending").length %>
            </h2>
          </div>

          <!-- Out Of Stock -->

          <div class="bg-white rounded-2xl p-6 shadow">
            <p class="text-slate-500">Out Of Stock</p>

            <h2 class="text-4xl font-bold mt-2">
              <%= products.filter(p => p.stock <= 0).length %>
            </h2>
          </div>
        </div>

        <!-- Search -->

        <div class="mt-8">
          <input
            type="text"
            placeholder="Search Product..."
            class="w-full md:w-96 h-12 rounded-xl border border-slate-300 px-4 focus:ring-4 focus:ring-indigo-100 outline-none"
          />
        </div>

        <!-- Products -->

        <% if(products.length){ %>

        <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-6 mt-8">
          <% products.forEach(product => { %>

          <div
            class="bg-white rounded-3xl shadow hover:shadow-xl transition overflow-hidden"
          >
            <!-- Product Image -->

            <div class="h-60 bg-slate-100">
              <% if(product.images && product.images.length){ %>

              <img
                src="<%= product.images[0].url %>"
                alt="<%= product.productName %>"
                class="w-full h-full object-cover"
              />

              <% }else{ %>

              <div class="w-full h-full flex items-center justify-center">
                <i class="fa-solid fa-image text-6xl text-slate-300"></i>
              </div>

              <% } %>
            </div>

            <!-- Product Content -->

            <div class="p-6">
              <div class="flex justify-between items-start">
                <div>
                  <h2 class="text-xl font-bold text-slate-800">
                    <%= product.productName %>
                  </h2>

                  <p class="text-slate-500 mt-1">
                    <%= product.brand || "No Brand" %>
                  </p>
                </div>

                <!-- Approval Status Badge -->

                <% if(product.approvalStatus === "approved"){ %>

                <span
                  class="bg-green-100 text-green-700 text-xs px-3 py-1 rounded-full"
                >
                  Approved
                </span>

                <% }else if(product.approvalStatus === "rejected"){ %>

                <span
                  class="bg-red-100 text-red-700 text-xs px-3 py-1 rounded-full"
                >
                  Rejected
                </span>

                <% }else{ %>

                <span
                  class="bg-yellow-100 text-yellow-700 text-xs px-3 py-1 rounded-full"
                >
                  Pending
                </span>

                <% } %>
              </div>

              <!-- Product Details -->

              <div class="mt-6 space-y-4">
                <!-- Category -->

                <div class="flex justify-between">
                  <span class="text-slate-500"> Category </span>

                  <span class="font-semibold">
                    <%= product.category ? product.category.categoryName :
                    "No-Category" %></span
                  >
                </div>

                <!-- Approval Status -->

                <div class="flex justify-between items-center">
                  <span class="text-slate-500"> Approval Status </span>

                  <% if (product.approvalStatus === "approved") { %>

                  <span class="font-semibold text-green-600">
                    <i class="fa-solid fa-circle-check mr-1"></i>
                    Approved
                  </span>

                  <% } else if (product.approvalStatus === "rejected") { %>

                  <span class="font-semibold text-red-600">
                    <i class="fa-solid fa-circle-xmark mr-1"></i>
                    Rejected
                  </span>

                  <% } else { %>

                  <span class="font-semibold text-yellow-600">
                    <i class="fa-solid fa-clock mr-1"></i>
                    Pending
                  </span>

                  <% } %>
                </div>

                <!-- Price -->

                <div class="flex justify-between">
                  <span class="text-slate-500"> Price </span>

                  <span class="font-bold text-indigo-600">
                    $<%= product.price %>
                  </span>
                </div>

                <!-- Stock Controller -->

                <div class="flex justify-between items-center">
                  <span class="text-slate-500"> Stock </span>

                  <div class="flex items-center gap-3">
                    <!-- Decrease -->

                    <% if(product.stock > 0){ %>

                    <a
                      href="/poeme-perfumery/seller/product/decrease-stock/<%= product._id %>"
                      class="w-9 h-9 rounded-lg bg-red-100 hover:bg-red-200 text-red-600 flex items-center justify-center"
                    >
                      <i class="fa-solid fa-minus"></i>
                    </a>

                    <% }else{ %>

                    <span
                      class="w-9 h-9 rounded-lg bg-gray-100 text-gray-400 flex items-center justify-center cursor-not-allowed"
                    >
                      <i class="fa-solid fa-minus"></i>
                    </span>

                    <% } %>

                    <!-- Stock Number -->

                    <span class="font-bold text-lg w-8 text-center">
                      <%= product.stock %>
                    </span>

                    <!-- Increase -->

                    <a
                      href="/poeme-perfumery/seller/product/increase-stock/<%= product._id %>"
                      class="w-9 h-9 rounded-lg bg-green-100 hover:bg-green-200 text-green-600 flex items-center justify-center"
                    >
                      <i class="fa-solid fa-plus"></i>
                    </a>
                  </div>
                </div>

                <!-- Stock Availability -->

                <% if(product.stock > 0){ %>

                <div
                  class="bg-green-100 text-green-700 rounded-xl py-2 text-center font-semibold"
                >
                  <i class="fa-solid fa-circle-check mr-2"></i>

                  In Stock (<%= product.stock %>)
                </div>

                <% }else{ %>

                <div
                  class="bg-red-100 text-red-700 rounded-xl py-2 text-center font-semibold"
                >
                  <i class="fa-solid fa-circle-xmark mr-2"></i>

                  Out Of Stock
                </div>

                <% } %>

                <!-- Mark Out Of Stock -->

                <% if(product.stock > 0){ %>

                <a
                  href="/poeme-perfumery/seller/product/out-of-stock/<%= product._id %>"
                  class="block w-full bg-red-600 hover:bg-red-700 text-white py-3 rounded-xl text-center font-semibold"
                >
                  <i class="fa-solid fa-ban mr-2"></i>

                  Mark Out Of Stock
                </a>

                <% } %>
              </div>

              <!-- Action Buttons -->

              <div class="flex gap-3 mt-8 flex-wrap">
                <!-- View -->

                <a
                  href="/poeme-perfumery/seller/product/view/<%= product._id %>"
                  class="flex-1 bg-slate-200 hover:bg-slate-300 text-slate-700 py-3 rounded-xl text-center font-semibold"
                >
                  <i class="fa-solid fa-eye mr-2"></i>
                  View
                </a>

                <!-- Edit -->

                <a
                  href="/poeme-perfumery/seller/edit-product/<%= product._id %>"
                  class="flex-1 bg-blue-100 hover:bg-blue-200 text-blue-700 py-3 rounded-xl text-center font-semibold"
                >
                  <i class="fa-solid fa-pen mr-2"></i>
                  Edit
                </a>

                <!-- Delete Product -->

                <form
                  action="/poeme-perfumery/seller/delete-product/<%= product._id %>"
                  method="POST"
                  class="flex-1"
                >
                  <button
                    type="submit"
                    class="w-full bg-red-100 hover:bg-red-200 text-red-700 py-3 rounded-xl text-center font-semibold"
                    onclick="
                      return confirm(
                        'Are you sure you want to delete this product?'
                      );
                    "
                  >
                    <i class="fa-solid fa-trash mr-2"></i>
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </div>

          <% }) %>
        </div>

        <% }else{ %>

        <!-- Empty State -->

        <div class="mt-12 bg-white rounded-3xl shadow py-24 text-center">
          <div
            class="w-28 h-28 rounded-full bg-slate-100 mx-auto flex items-center justify-center"
          >
            <i class="fa-solid fa-box-open text-6xl text-slate-300"></i>
          </div>

          <h2 class="text-3xl font-bold mt-8">No Products Found</h2>

          <p class="text-slate-500 mt-3">
            Start by creating your first product.
          </p>

          <a
            href="/poeme-perfumery/seller/create/product"
            class="inline-block mt-8 bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl font-semibold"
          >
            <i class="fa-solid fa-plus mr-2"></i>

            Create Product
          </a>
        </div>

        <% } %>
      </section>
    </main>
  </body>
</html>
