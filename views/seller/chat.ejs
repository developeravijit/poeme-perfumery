<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Seller Chat Support | POÈME Perfumery</title>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      window.sellerId = "<%= seller._id %>";
      window.sellerName = "<%= seller.name || 'Seller' %>";
    </script>

    <link rel="stylesheet" href="/css/output.css" />
  </head>

  <body class="bg-slate-100">
    <%- include("partials/sidebar.ejs") %>

    <main class="ml-72 min-h-screen bg-[#FCFBF8]">
      <%- include("partials/navbar.ejs") %>

      <section class="p-8">
        <div class="max-w-5xl mx-auto px-6">
          <div class="text-center mb-12">
            <p class="uppercase tracking-[8px] text-[#B68D40] font-semibold">
              Seller Support
            </p>

            <h1 class="text-5xl font-bold mt-5">Live Chat with Support</h1>

            <p class="mt-5 text-stone-500">
              Chat directly with our customer care team as a seller.
            </p>
          </div>

          <div
            class="bg-white rounded-[36px] shadow-xl border border-stone-200 overflow-hidden"
          >
            <div
              class="bg-[#B68D40] px-8 py-6 flex items-center justify-between"
            >
              <div>
                <h2 class="text-2xl font-semibold text-white">
                  Customer Support
                </h2>

                <p class="text-[#FFF2D5]">
                  <span
                    class="inline-block w-2 h-2 rounded-full bg-green-400"
                  ></span>
                  Online
                </p>
              </div>

              <div class="text-right text-white">
                <div id="connectedUser" class="font-semibold">
                  No active connection
                </div>
                <div class="text-sm text-white/80">
                  Connect to a waiting user below
                </div>
                <div class="mt-3">
                  <button
                    id="disconnectBtn"
                    disabled
                    class="rounded-full border border-white/50 bg-white/10 px-4 py-2 text-sm text-white transition hover:bg-white/20 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    Disconnect
                  </button>
                </div>
              </div>
            </div>

            <div class="grid lg:grid-cols-3 gap-6 p-8">
              <div
                class="lg:col-span-1 bg-slate-50 rounded-3xl border border-slate-200 p-6"
              >
                <div class="flex items-center justify-between mb-6">
                  <div>
                    <p class="text-slate-500 uppercase tracking-[4px] text-xs">
                      Waiting Queue
                    </p>
                    <h3 class="text-2xl font-semibold mt-2">Users</h3>
                  </div>
                  <span
                    id="queueCount"
                    class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-indigo-600 text-white text-sm font-semibold"
                    >0</span
                  >
                </div>
                <div id="queueList" class="space-y-4">
                  <div
                    class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-slate-500 text-center"
                  >
                    No users waiting right now.
                  </div>
                </div>
              </div>

              <div class="lg:col-span-2 flex flex-col gap-4">
                <div
                  id="chatBox"
                  class="h-[500px] max-h-[500px] overflow-y-auto p-8 bg-[#FCFBF8] space-y-5 rounded-3xl border border-slate-200"
                ></div>

                <div class="border-t border-stone-200 p-6 rounded-b-3xl">
                  <div class="flex gap-4">
                    <input
                      id="message"
                      type="text"
                      placeholder="Type your message..."
                      class="flex-1 rounded-full border border-stone-300 px-6 py-4 outline-none focus:border-[#B68D40]"
                    />
                    <button
                      id="sendBtn"
                      class="bg-[#B68D40] hover:bg-[#9D7A37] text-white px-8 rounded-full transition"
                    >
                      Send
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script src="/js/index.js"></script>
    <script src="/js/contact.js"></script>
  </body>
</html>
