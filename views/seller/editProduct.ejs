<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Edit Product</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
</head>

<body class="bg-slate-100">

  <%- include("partials/sidebar") %>

  <main class="ml-72 min-h-screen">

    <%- include("partials/navbar") %>

    <section class="p-8">

      <!-- Header -->

      <div class="flex items-center justify-between mb-8">

        <div>
          <h1 class="text-3xl font-bold text-slate-800">
            Edit Product
          </h1>

          <p class="text-slate-500 mt-2">
            Update your product information.
          </p>
        </div>

        <a href="/poeme-perfumery/seller/products" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-5 py-3 rounded-xl font-semibold">
          <i class="fa-solid fa-arrow-left mr-2"></i>
          Back to Products
        </a>

      </div>


      <!-- Flash Messages -->

      <% if(success && success.length){ %>

      <div class="mb-6 bg-green-100 border border-green-300 text-green-700 rounded-xl p-4">
        <%= success[0] %>
      </div>

      <% } %>


      <% if(error && error.length){ %>

      <div class="mb-6 bg-red-100 border border-red-300 text-red-700 rounded-xl p-4">
        <%= error[0] %>
      </div>

      <% } %>


      <!-- Form Card -->

      <div class="bg-white rounded-3xl shadow p-8">

        <form action="/poeme-perfumery/seller/edit-product/<%= product._id %>" method="POST">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">


            <!-- Product Name -->

            <div>
              <label for="productName" class="block text-sm font-semibold text-slate-700 mb-2">
                Product Name
              </label>

              <input type="text" id="productName" name="productName" value="<%= product.productName %>" required class="w-full h-12 border border-slate-300 rounded-xl px-4 outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500" />
            </div>


            <!-- Category -->

            <div>
              <label for="categoryId" class="block text-sm font-semibold text-slate-700 mb-2">
                Category
              </label>

              <select id="categoryId" name="categoryId" required class="w-full h-12 border border-slate-300 rounded-xl px-4 bg-white outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500">

                <option value="">
                  Select Category
                </option>

                <% categories.forEach(category => { %>

                <option value="<%= category._id %>" <%= product.categoryId.toString() === category._id.toString()
                        ? "selected"
                        : ""
                      %>>
                  <%= category.categoryName %>
                </option>

                <% }) %>

              </select>
            </div>


            <!-- Price -->

            <div>
              <label for="price" class="block text-sm font-semibold text-slate-700 mb-2">
                Price
              </label>

              <div class="relative">

                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">
                  $
                </span>

                <input type="number" id="price" name="price" value="<%= product.price %>" min="0" step="0.01" required class="w-full h-12 border border-slate-300 rounded-xl pl-9 pr-4 outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500" />

              </div>
            </div>


            <!-- Stock -->

            <div>
              <label for="stock" class="block text-sm font-semibold text-slate-700 mb-2">
                Stock
              </label>

              <input type="number" id="stock" name="stock" value="<%= product.stock %>" min="0" required class="w-full h-12 border border-slate-300 rounded-xl px-4 outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500" />
            </div>


            <!-- SKU -->

            <div>
              <label for="sku" class="block text-sm font-semibold text-slate-700 mb-2">
                SKU
              </label>

              <input type="text" id="sku" name="sku" value="<%= product.sku %>" required class="w-full h-12 border border-slate-300 rounded-xl px-4 outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500" />
            </div>


            <!-- Brand -->

            <div>
              <label for="brand" class="block text-sm font-semibold text-slate-700 mb-2">
                Brand
              </label>

              <input type="text" id="brand" name="brand" value="<%= product.brand || '' %>" class="w-full h-12 border border-slate-300 rounded-xl px-4 outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500" />
            </div>


            <!-- Tags -->

            <div class="md:col-span-2">

              <label for="tags" class="block text-sm font-semibold text-slate-700 mb-2">
                Tags
              </label>

              <input type="text" id="tags" name="tags" value="<%= product.tags && product.tags.length ? product.tags.join(', ') : '' %>" placeholder="perfume, luxury, men" class="w-full h-12 border border-slate-300 rounded-xl px-4 outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500" />

              <p class="text-sm text-slate-400 mt-2">
                Separate multiple tags with commas.
              </p>

            </div>


            <!-- Description -->

            <div class="md:col-span-2">

              <label for="description" class="block text-sm font-semibold text-slate-700 mb-2">
                Description
              </label>

              <textarea id="description" name="description" rows="6" required class="w-full border border-slate-300 rounded-xl px-4 py-3 outline-none resize-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500"><%= product.description %></textarea>

            </div>

          </div>


          <!-- Current Images -->

          <% if(product.images && product.images.length){ %>

          <div class="mt-8">

            <h2 class="text-lg font-bold text-slate-800 mb-4">
              Product Images
            </h2>

            <div class="flex flex-wrap gap-4">

              <% product.images.forEach(image => { %>

              <div class="w-28 h-28 rounded-xl border border-slate-200 overflow-hidden bg-slate-100">
                <img src="<%= image.url %>" alt="Product Image" class="w-full h-full object-cover" />
              </div>

              <% }) %>

            </div>

          </div>

          <% } %>


          <!-- Stock Status -->

          <div class="mt-8">

            <% if(product.stock > 0){ %>

            <div class="inline-flex items-center bg-green-100 text-green-700 px-4 py-2 rounded-xl font-semibold">
              <i class="fa-solid fa-circle-check mr-2"></i>

              In Stock (<%= product.stock %>)
            </div>

            <% }else{ %>

            <div class="inline-flex items-center bg-red-100 text-red-700 px-4 py-2 rounded-xl font-semibold">
              <i class="fa-solid fa-circle-xmark mr-2"></i>

              Out Of Stock
            </div>

            <% } %>

          </div>


          <!-- Buttons -->

          <div class="flex items-center justify-end gap-4 mt-10 pt-6 border-t border-slate-200">

            <a href="/poeme-perfumery/seller/products" class="px-6 py-3 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold">
              Cancel
            </a>

            <button type="submit" class="px-7 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold">
              <i class="fa-solid fa-floppy-disk mr-2"></i>
              Update Product
            </button>

          </div>

        </form>

      </div>

    </section>

  </main>

</body>

</html>