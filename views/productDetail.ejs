<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= product.productName %> | POÈME Perfumery</title>

    <!-- Tailwind -->

    <link rel="stylesheet" href="/css/output.css" />

    <!-- Google Fonts -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <style>
      body {
        font-family: "Inter", sans-serif;
      }

      .serif {
        font-family: "Cormorant Garamond", serif;
      }

      .thumbnail-active {
        border-color: #b68d40 !important;
        box-shadow: 0 0 0 2px rgba(182, 141, 64, 0.15);
      }

      .hide-scrollbar::-webkit-scrollbar {
        display: none;
      }

      .hide-scrollbar {
        scrollbar-width: none;
      }
    </style>
  </head>

  <body class="bg-[#FCFBF8] text-stone-900">
    <!-- =====================================================
       NAVBAR
  ====================================================== -->

    <%- include("layout/navbar.ejs") %>

    <!-- =====================================================
       SUCCESS MESSAGE
  ====================================================== -->

    <% if (success && success.length) { %>

    <div
      id="successMessage"
      class="fixed top-24 right-5 z-[100] bg-green-600 text-white px-6 py-4 rounded-2xl shadow-xl"
    >
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-circle-check"></i>

        <div>
          <% success.forEach(function(message) { %>

          <p><%= message %></p>

          <% }) %>
        </div>
      </div>
    </div>

    <% } %>

    <!-- =====================================================
       ERROR MESSAGE
  ====================================================== -->

    <% if (error && error.length) { %>

    <div
      id="errorMessage"
      class="fixed top-24 right-5 z-[100] bg-red-600 text-white px-6 py-4 rounded-2xl shadow-xl"
    >
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-circle-exclamation"></i>

        <div>
          <% error.forEach(function(message) { %>

          <p><%= message %></p>

          <% }) %>
        </div>
      </div>
    </div>

    <% } %>

    <!-- =====================================================
       BREADCRUMB
  ====================================================== -->

    <section class="pt-28 pb-6">
      <div class="max-w-7xl mx-auto px-5 lg:px-8">
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <a
            href="/poeme-perfumery/home"
            class="text-stone-500 hover:text-[#B68D40]"
          >
            Home
          </a>

          <i class="fa-solid fa-chevron-right text-[10px] text-stone-400"></i>

          <a
            href="/poeme-perfumery/perfumes"
            class="text-stone-500 hover:text-[#B68D40]"
          >
            Perfumes
          </a>

          <% if (product.category && product.category.categoryName) { %>

          <i class="fa-solid fa-chevron-right text-[10px] text-stone-400"></i>

          <span class="text-stone-500">
            <%= product.category.categoryName %>
          </span>

          <% } %>

          <i class="fa-solid fa-chevron-right text-[10px] text-stone-400"></i>

          <span class="font-medium text-stone-900">
            <%= product.productName %>
          </span>
        </div>
      </div>
    </section>

    <!-- =====================================================
       PRODUCT
  ====================================================== -->

    <main class="pb-20">
      <div class="max-w-7xl mx-auto px-5 lg:px-8">
        <div
          class="bg-white border border-stone-200 rounded-[32px] overflow-hidden shadow-xl"
        >
          <div class="grid lg:grid-cols-2">
            <!-- =================================================
               PRODUCT IMAGES
          ================================================== -->

            <div
              class="bg-gradient-to-br from-[#FBF8F2] via-white to-[#F4EBDD] p-5 md:p-8 lg:p-10"
            >
              <div
                class="grid grid-cols-[70px_1fr] md:grid-cols-[90px_1fr] gap-4"
              >
                <!-- THUMBNAILS -->

                <div
                  class="flex flex-col gap-3 max-h-[620px] overflow-y-auto hide-scrollbar"
                >
                  <% if (product.images && product.images.length) { %>

                  <% product.images.forEach(function(image, index) { %>

                  <button
                    type="button"
                    class="thumbnail flex-shrink-0 w-[65px] h-[75px] md:w-[80px] md:h-[90px] bg-white border-2 rounded-2xl overflow-hidden <%= index === 0 ? 'thumbnail-active' : 'border-stone-200' %>"
                    data-image="<%= image.url %>"
                  >
                    <img
                      src="<%= image.url %>"
                      alt="<%= product.productName %>"
                      class="w-full h-full object-contain p-2"
                    />
                  </button>

                  <% }) %>

                  <% } else { %>

                  <div
                    class="w-[65px] h-[75px] bg-white border border-stone-200 rounded-2xl flex items-center justify-center"
                  >
                    <i class="fa-solid fa-image text-2xl text-stone-300"></i>
                  </div>

                  <% } %>
                </div>

                <!-- MAIN IMAGE -->

                <div
                  class="relative min-h-[480px] md:min-h-[620px] bg-white border border-stone-200 rounded-[28px] flex items-center justify-center overflow-hidden"
                >
                  <!-- Background -->

                  <div
                    class="absolute w-[350px] h-[350px] bg-[#E9D8B4]/40 rounded-full blur-[100px]"
                  ></div>

                  <!-- Stock -->

                  <div class="absolute top-5 left-5 z-20">
                    <% if (product.stock > 0) { %>

                    <span
                      class="inline-flex items-center gap-2 bg-green-100 text-green-700 px-4 py-2 rounded-full text-xs font-bold"
                    >
                      <span class="w-2 h-2 bg-green-600 rounded-full"></span>

                      In Stock
                    </span>

                    <% } else { %>

                    <span
                      class="inline-flex items-center gap-2 bg-red-100 text-red-700 px-4 py-2 rounded-full text-xs font-bold"
                    >
                      <span class="w-2 h-2 bg-red-600 rounded-full"></span>

                      Out Of Stock
                    </span>

                    <% } %>
                  </div>

                  <!-- Zoom -->

                  <button
                    type="button"
                    id="zoomButton"
                    class="absolute top-5 right-5 z-20 w-11 h-11 bg-white border border-stone-200 rounded-full shadow-md flex items-center justify-center hover:text-[#B68D40]"
                  >
                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                  </button>

                  <% if (product.images && product.images.length) { %>

                  <img
                    id="mainProductImage"
                    src="<%= product.images[0].url %>"
                    alt="<%= product.productName %>"
                    class="relative z-10 max-w-full max-h-[580px] w-full h-full object-contain p-8 md:p-12 cursor-zoom-in transition duration-500 hover:scale-105"
                  />

                  <% } else { %>

                  <div class="relative z-10 text-center text-stone-300">
                    <i class="fa-solid fa-image text-8xl"></i>

                    <p class="mt-4">No product image</p>
                  </div>

                  <% } %>
                </div>
              </div>
            </div>

            <!-- =================================================
               PRODUCT INFORMATION
          ================================================== -->

            <div class="p-6 md:p-10 lg:p-12">
              <!-- BRAND -->

              <div class="flex items-center gap-3 flex-wrap">
                <span
                  class="uppercase tracking-[5px] text-xs font-bold text-[#B68D40]"
                >
                  <%= product.brand || "POÈME" %>
                </span>

                <% if (product.category && product.category.categoryName) { %>

                <span
                  class="px-3 py-1 bg-stone-100 rounded-full text-xs text-stone-600"
                >
                  <%= product.category.categoryName %>
                </span>

                <% } %>
              </div>

              <!-- NAME -->

              <h1
                class="serif mt-5 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
              >
                <%= product.productName %>
              </h1>

              <!-- RATING -->

              <div class="flex items-center gap-4 mt-5">
                <div class="flex gap-1 text-[#B68D40]">
                  <i class="fa-solid fa-star"></i>

                  <i class="fa-solid fa-star"></i>

                  <i class="fa-solid fa-star"></i>

                  <i class="fa-solid fa-star"></i>

                  <i class="fa-solid fa-star-half-stroke"></i>
                </div>

                <span class="text-sm text-stone-500"> Premium Fragrance </span>
              </div>

              <div class="h-px bg-stone-200 my-7"></div>

              <!-- PRICE -->

              <div>
                <% if (
                product.discountPrice &&
                Number(product.discountPrice) < Number(product.price)
              ) { %>

                <div class="flex flex-wrap items-end gap-4">
                  <span class="text-5xl font-bold">
                    ₹<%= Number(
                      product.discountPrice
                    ).toLocaleString("en-IN") %>
                  </span>

                  <span class="text-xl text-stone-400 line-through">
                    ₹<%= Number(
                      product.price
                    ).toLocaleString("en-IN") %>
                  </span>

                  <span
                    class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-bold"
                  >
                    <%= Math.round(
                      (
                        (
                          Number(product.price) -
                          Number(product.discountPrice)
                        ) /
                        Number(product.price)
                      ) * 100
                    ) %>% OFF
                  </span>
                </div>

                <% } else { %>

                <span class="text-5xl font-bold">
                  ₹<%= Number(
                    product.price || 0
                  ).toLocaleString("en-IN") %>
                </span>

                <% } %>

                <p class="mt-2 text-sm text-stone-500">
                  Inclusive of applicable taxes
                </p>
              </div>

              <!-- DESCRIPTION -->

              <div class="mt-8">
                <h2 class="text-xl font-bold">About this product</h2>

                <p class="mt-3 text-stone-600 leading-8">
                  <%= product.description ||
                  "A premium fragrance crafted with elegance and sophistication." %>
                </p>
              </div>

              <!-- STOCK -->

              <div
                class="mt-7 bg-[#FCF8F0] border border-[#E9D8B4] rounded-2xl p-5"
              >
                <% if (product.stock > 0) { %>

                <div class="flex items-center gap-4">
                  <div
                    class="w-11 h-11 bg-green-100 text-green-700 rounded-full flex items-center justify-center"
                  >
                    <i class="fa-solid fa-check"></i>
                  </div>

                  <div>
                    <p class="font-bold">In Stock</p>

                    <p class="text-sm text-stone-500 mt-1">
                      <%= product.stock %>
                      units available
                    </p>
                  </div>
                </div>

                <% } else { %>

                <div class="flex items-center gap-4">
                  <div
                    class="w-11 h-11 bg-red-100 text-red-700 rounded-full flex items-center justify-center"
                  >
                    <i class="fa-solid fa-xmark"></i>
                  </div>

                  <div>
                    <p class="font-bold text-red-700">Out Of Stock</p>

                    <p class="text-sm text-stone-500 mt-1">
                      This product is currently unavailable.
                    </p>
                  </div>
                </div>

                <% } %>
              </div>

              <!-- =================================================
                 BUTTONS
            ================================================== -->

              <div class="mt-7">
                <% if (product.stock > 0) { %>

                <div class="grid sm:grid-cols-2 gap-4">
                  <!-- ADD TO CART -->

                  <a
                    href="/poeme-perfumery/addToCart/<%= product._id %>"
                    class="h-14 bg-[#B68D40] hover:bg-[#967332] text-white rounded-2xl flex items-center justify-center gap-3 font-bold shadow-lg transition"
                  >
                    <i class="fa-solid fa-cart-shopping"></i>

                    Add To Cart
                  </a>

                  <!-- BUY NOW -->

                  <a
                    href="/poeme-perfumery/addToCart/<%= product._id %>"
                    class="h-14 border-2 border-stone-900 hover:bg-stone-900 hover:text-white rounded-2xl flex items-center justify-center gap-3 font-bold transition"
                  >
                    <i class="fa-solid fa-bolt"></i>

                    Buy Now
                  </a>
                </div>

                <% } else { %>

                <button
                  disabled
                  class="w-full h-14 bg-stone-200 text-stone-500 rounded-2xl font-bold cursor-not-allowed"
                >
                  Out Of Stock
                </button>

                <% } %>
              </div>

              <!-- TRUST -->

              <div class="grid grid-cols-3 gap-3 mt-8">
                <div
                  class="border border-stone-200 rounded-2xl p-4 text-center"
                >
                  <div
                    class="w-10 h-10 mx-auto bg-[#F7EEDC] text-[#B68D40] rounded-full flex items-center justify-center"
                  >
                    <i class="fa-solid fa-shield-halved"></i>
                  </div>

                  <p class="mt-3 text-xs font-bold">Authentic</p>
                </div>

                <div
                  class="border border-stone-200 rounded-2xl p-4 text-center"
                >
                  <div
                    class="w-10 h-10 mx-auto bg-[#F7EEDC] text-[#B68D40] rounded-full flex items-center justify-center"
                  >
                    <i class="fa-solid fa-truck"></i>
                  </div>

                  <p class="mt-3 text-xs font-bold">Delivery</p>
                </div>

                <div
                  class="border border-stone-200 rounded-2xl p-4 text-center"
                >
                  <div
                    class="w-10 h-10 mx-auto bg-[#F7EEDC] text-[#B68D40] rounded-full flex items-center justify-center"
                  >
                    <i class="fa-solid fa-headset"></i>
                  </div>

                  <p class="mt-3 text-xs font-bold">Support</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- =====================================================
           LOWER PRODUCT INFORMATION
      ====================================================== -->

        <div class="grid lg:grid-cols-3 gap-6 mt-8">
          <!-- DESCRIPTION -->

          <div
            class="lg:col-span-2 bg-white border border-stone-200 rounded-[30px] shadow-lg p-7 md:p-9"
          >
            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 rounded-full bg-[#F7EEDC] text-[#B68D40] flex items-center justify-center"
              >
                <i class="fa-solid fa-sparkles"></i>
              </div>

              <div>
                <p
                  class="uppercase tracking-[4px] text-xs font-bold text-[#B68D40]"
                >
                  POÈME
                </p>

                <h2 class="text-2xl font-bold">About this fragrance</h2>
              </div>
            </div>

            <div class="mt-7">
              <p class="text-stone-600 leading-8">
                <%= product.description ||
                "Discover a sophisticated fragrance created for those who appreciate elegance, character and refined presentation." %>
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-5 mt-8">
              <div class="bg-stone-50 rounded-2xl p-6">
                <i class="fa-solid fa-gem text-[#B68D40] text-xl"></i>

                <h3 class="mt-4 text-lg font-bold">Premium Quality</h3>

                <p class="mt-2 text-sm text-stone-500 leading-7">
                  A refined fragrance experience designed around elegance and
                  sophistication.
                </p>
              </div>

              <div class="bg-stone-50 rounded-2xl p-6">
                <i class="fa-solid fa-leaf text-[#B68D40] text-xl"></i>

                <h3 class="mt-4 text-lg font-bold">Elegant Character</h3>

                <p class="mt-2 text-sm text-stone-500 leading-7">
                  A sophisticated addition to your personal fragrance
                  collection.
                </p>
              </div>

              <div class="bg-stone-50 rounded-2xl p-6">
                <i class="fa-solid fa-award text-[#B68D40] text-xl"></i>

                <h3 class="mt-4 text-lg font-bold">Premium Experience</h3>

                <p class="mt-2 text-sm text-stone-500 leading-7">
                  Carefully presented for a premium shopping experience.
                </p>
              </div>

              <div class="bg-stone-50 rounded-2xl p-6">
                <i class="fa-solid fa-box-open text-[#B68D40] text-xl"></i>

                <h3 class="mt-4 text-lg font-bold">Ready To Enjoy</h3>

                <p class="mt-2 text-sm text-stone-500 leading-7">
                  Available to order while stock lasts.
                </p>
              </div>
            </div>
          </div>

          <!-- PRODUCT DETAILS -->

          <div
            class="bg-white border border-stone-200 rounded-[30px] shadow-lg p-7 md:p-9"
          >
            <h2 class="text-2xl font-bold">Product Details</h2>

            <div class="mt-6 divide-y divide-stone-200">
              <!-- BRAND -->

              <div class="flex justify-between gap-4 py-4">
                <span class="text-stone-500"> Brand </span>

                <span class="font-semibold text-right">
                  <%= product.brand || "POÈME" %>
                </span>
              </div>

              <!-- CATEGORY -->

              <div class="flex justify-between gap-4 py-4">
                <span class="text-stone-500"> Category </span>

                <span class="font-semibold text-right">
                  <%= product.category?.categoryName || "Perfume" %>
                </span>
              </div>

              <!-- STOCK -->

              <div class="flex justify-between gap-4 py-4">
                <span class="text-stone-500"> Availability </span>

                <span
                  class="font-semibold <%= product.stock > 0 ? 'text-green-700' : 'text-red-600' %>"
                >
                  <%= product.stock > 0 ? "In Stock" : "Out Of Stock" %>
                </span>
              </div>

              <!-- QUANTITY -->

              <div class="flex justify-between gap-4 py-4">
                <span class="text-stone-500"> Available </span>

                <span class="font-semibold"> <%= product.stock || 0 %> </span>
              </div>
            </div>
          </div>
        </div>

        <!-- =====================================================
           CONTINUE SHOPPING
      ====================================================== -->

        <div class="text-center mt-12">
          <a
            href="/poeme-perfumery/perfumes"
            class="inline-flex items-center gap-3 px-8 py-4 bg-white border border-stone-300 rounded-full font-semibold hover:border-[#B68D40] hover:text-[#B68D40] transition"
          >
            <i class="fa-solid fa-arrow-left"></i>

            Continue Shopping
          </a>
        </div>
      </div>
    </main>

    <!-- =====================================================
       FOOTER
  ====================================================== -->

    <%- include("layout/footer.ejs") %>

    <!-- =====================================================
       IMAGE ZOOM MODAL
  ====================================================== -->

    <div
      id="imageModal"
      class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-5"
    >
      <button
        id="closeModal"
        type="button"
        class="absolute top-5 right-5 w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-xl"
      >
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>

      <img
        id="modalImage"
        src=""
        alt="<%= product.productName %>"
        class="max-w-[95vw] max-h-[90vh] object-contain rounded-2xl"
      />
    </div>

    <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        /*
         * ===================================================
         * PRODUCT IMAGE GALLERY
         * ===================================================
         */

        const mainImage = document.getElementById("mainProductImage");

        const thumbnails = document.querySelectorAll(".thumbnail");

        thumbnails.forEach(function (thumbnail) {
          thumbnail.addEventListener("click", function () {
            const imageUrl = this.getAttribute("data-image");

            if (!mainImage || !imageUrl) {
              return;
            }

            mainImage.src = imageUrl;

            thumbnails.forEach(function (item) {
              item.classList.remove("thumbnail-active");

              item.classList.remove("border-[#B68D40]");

              item.classList.add("border-stone-200");
            });

            this.classList.add("thumbnail-active");
          });
        });

        /*
         * ===================================================
         * IMAGE ZOOM
         * ===================================================
         */

        const zoomButton = document.getElementById("zoomButton");

        const imageModal = document.getElementById("imageModal");

        const modalImage = document.getElementById("modalImage");

        const closeModal = document.getElementById("closeModal");

        function openModal() {
          if (!mainImage || !imageModal || !modalImage) {
            return;
          }

          modalImage.src = mainImage.src;

          imageModal.classList.remove("hidden");

          imageModal.classList.add("flex");

          document.body.classList.add("overflow-hidden");
        }

        function closeImageModal() {
          if (!imageModal) {
            return;
          }

          imageModal.classList.remove("flex");

          imageModal.classList.add("hidden");

          document.body.classList.remove("overflow-hidden");
        }

        if (zoomButton) {
          zoomButton.addEventListener("click", openModal);
        }

        if (mainImage) {
          mainImage.addEventListener("click", openModal);
        }

        if (closeModal) {
          closeModal.addEventListener("click", closeImageModal);
        }

        if (imageModal) {
          imageModal.addEventListener("click", function (event) {
            if (event.target === imageModal) {
              closeImageModal();
            }
          });
        }

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") {
            closeImageModal();
          }
        });

        /*
         * ===================================================
         * FLASH MESSAGE AUTO HIDE
         * ===================================================
         */

        setTimeout(function () {
          const success = document.getElementById("successMessage");

          const error = document.getElementById("errorMessage");

          if (success) {
            success.style.transition = "opacity 0.5s ease";

            success.style.opacity = "0";

            setTimeout(function () {
              success.remove();
            }, 500);
          }

          if (error) {
            error.style.transition = "opacity 0.5s ease";

            error.style.opacity = "0";

            setTimeout(function () {
              error.remove();
            }, 500);
          }
        }, 3500);
      });
    </script>
  </body>
</html>
