<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My Orders | POÈME Perfumery</title>

    <link rel="stylesheet" href="/css/output.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#FCFBF8]">
    <%- include("layout/navbar.ejs") %>

    <!-- Hero -->
    <section
      class="pt-36 pb-16 bg-gradient-to-b from-[#F8F3EA] to-[#FCFBF8] relative overflow-hidden"
    >
      <div
        class="absolute -top-32 left-0 w-[450px] h-[450px] rounded-full bg-[#F3E7D0] blur-[170px] opacity-70"
      ></div>

      <div
        class="absolute -bottom-40 right-0 w-[400px] h-[400px] rounded-full bg-[#EFE2C9] blur-[170px] opacity-70"
      ></div>

      <div class="relative max-w-7xl mx-auto px-6 text-center">
        <p class="uppercase tracking-[8px] text-[#B68D40] font-semibold">
          Purchase History
        </p>

        <h1 class="mt-4 text-6xl font-bold text-stone-900">My Orders</h1>

        <p class="mt-6 text-lg text-stone-600 max-w-2xl mx-auto">
          View your previous perfume purchases, track deliveries, and reorder
          your favourite fragrances anytime.
        </p>
      </div>
    </section>

    <!-- Orders -->
    <section class="max-w-7xl mx-auto px-6 pb-24">
      <% if (orders && orders.length > 0) { %>

      <div class="space-y-10">
        <% orders.forEach(order => { %>

        <div
          class="bg-white rounded-[30px] shadow-lg border border-stone-200 overflow-hidden"
        >
          <!-- ========================= -->
          <!-- ORDER HEADER -->
          <!-- ========================= -->

          <div
            class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 px-8 py-6 border-b border-stone-200"
          >
            <div>
              <h2 class="text-3xl font-semibold text-stone-900">
                Order #<%= order.orderId || order._id %>
              </h2>

              <div class="mt-3 flex flex-wrap gap-6 text-sm text-stone-500">
                <p>
                  Ordered: <%= order.createdAt ? new
                  Date(order.createdAt).toLocaleDateString("en-IN") : "N/A" %>
                </p>

                <p>Payment: <%= order.paymentMethod || "razorpay" %></p>

                <p>Payment Status: <%= order.paymentStatus || "pending" %></p>
              </div>
            </div>

            <!-- ORDER STATUS -->

            <% if (order.orderStatus === "delivered") { %>

            <span
              class="px-5 py-3 rounded-full bg-green-100 text-green-700 font-semibold"
            >
              Delivered
            </span>

            <% } else if (
                  order.orderStatus === "shipped"
                ) { %>

            <span
              class="px-5 py-3 rounded-full bg-blue-100 text-blue-700 font-semibold"
            >
              Shipped
            </span>

            <% } else if (
                  order.orderStatus === "confirmed" ||
                  order.orderStatus === "processing"
                ) { %>

            <span
              class="px-5 py-3 rounded-full bg-yellow-100 text-yellow-700 font-semibold"
            >
              Processing
            </span>

            <% } else if (
                  order.orderStatus === "cancelled"
                ) { %>

            <span
              class="px-5 py-3 rounded-full bg-red-100 text-red-600 font-semibold"
            >
              Cancelled
            </span>

            <% } else { %>

            <span
              class="px-5 py-3 rounded-full bg-gray-100 text-gray-600 font-semibold"
            >
              <%= order.orderStatus || "Pending" %>
            </span>

            <% } %>
          </div>

          <!-- ========================= -->
          <!-- PRODUCTS -->
          <!-- ========================= -->

          <div class="divide-y divide-stone-200">
            <% if (order.items && order.items.length > 0) { %> <%
            order.items.forEach(item => { %>

            <div class="p-8 flex flex-col lg:flex-row gap-8">
              <!-- PRODUCT IMAGE -->

              <div
                class="w-full lg:w-52 h-52 bg-[#F8F6F2] rounded-3xl flex items-center justify-center overflow-hidden"
              >
                <% if (item.image) { %>

                <img
                  src="<%= item.image.startsWith('/') ? item.image : '/assets/' + item.image %>"
                  class="max-h-44 max-w-full object-contain"
                  alt="<%= item.productName || 'Product' %>"
                />

                <% } else { %>

                <div class="text-stone-400 text-sm">No Image</div>

                <% } %>
              </div>

              <!-- PRODUCT DETAILS -->

              <div class="flex-1">
                <!-- PRODUCT NAME -->

                <h3 class="text-4xl font-semibold text-stone-900">
                  <%= item.productName || "Product" %>
                </h3>

                <p class="mt-4 text-stone-500 leading-7">
                  Thank you for purchasing this fragrance from POÈME Perfumery.
                </p>

                <!-- PRODUCT INFORMATION -->

                <div class="grid md:grid-cols-3 gap-6 mt-8">
                  <!-- QUANTITY -->

                  <div>
                    <p class="text-sm text-stone-500">Quantity</p>

                    <h4 class="text-xl font-semibold mt-1">
                      <%= item.quantity || 0 %>
                    </h4>
                  </div>

                  <!-- UNIT PRICE -->

                  <div>
                    <p class="text-sm text-stone-500">Unit Price</p>

                    <h4 class="text-xl font-semibold mt-1">
                      ₹<%= Number(item.price || 0).toLocaleString("en-IN") %>
                    </h4>
                  </div>

                  <!-- TOTAL -->

                  <div>
                    <p class="text-sm text-stone-500">Total</p>

                    <h4 class="text-2xl font-bold text-[#B68D40] mt-1">
                      ₹<%= Number(
                                item.totalPrice ||
                                ((item.price || 0) * (item.quantity || 0))
                              ).toLocaleString("en-IN") %>
                    </h4>
                  </div>
                </div>
              </div>
            </div>

            <% }) %>

            <% } else { %>

            <div class="p-10 text-center text-stone-500">
              No products found in this order.
            </div>

            <% } %>
          </div>

          <!-- ========================= -->
          <!-- ORDER SUMMARY -->
          <!-- ========================= -->

          <div class="bg-[#FCFBF8] px-8 py-8">
            <div class="grid lg:grid-cols-2 gap-10">
              <!-- SHIPPING ADDRESS -->

              <div>
                <h3 class="text-2xl font-semibold">Shipping Address</h3>

                <% if (order.shippingAddress) { %>

                <p class="mt-5 text-stone-600 leading-8">
                  <%= order.shippingAddress.name || "N/A" %>
                  <br />

                  <%= order.shippingAddress.address || "N/A" %>
                  <br />

                  <%= order.shippingAddress.city || "N/A" %>,
                  <%= order.shippingAddress.state || "N/A" %>
                  <br />

                  <%= order.shippingAddress.pincode || "N/A" %>
                  <br />

                  Phone:
                  <%= order.shippingAddress.phone || "N/A" %>
                </p>

                <% } else { %>

                <p class="mt-5 text-stone-500">
                  Shipping address not available.
                </p>

                <% } %>
              </div>

              <!-- PRICE SUMMARY -->

              <div>
                <div class="space-y-4">
                  <!-- SUBTOTAL -->

                  <div class="flex justify-between">
                    <span> Subtotal </span>

                    <span>
                      ₹<%= Number(
                            order.subtotal || 0
                          ).toLocaleString("en-IN") %>
                    </span>
                  </div>

                  <!-- SHIPPING -->

                  <div class="flex justify-between">
                    <span> Shipping </span>

                    <span>
                      ₹<%= Number(
                            order.shipping || 0
                          ).toLocaleString("en-IN") %>
                    </span>
                  </div>

                  <!-- TAX -->

                  <div class="flex justify-between">
                    <span> Tax </span>

                    <span>
                      ₹<%= Number(
                            order.tax || 0
                          ).toLocaleString("en-IN") %>
                    </span>
                  </div>

                  <hr />

                  <!-- TOTAL -->

                  <div class="flex justify-between text-2xl font-bold">
                    <span> Total </span>

                    <span class="text-[#B68D40]">
                      ₹<%= Number( order.total || 0 ).toLocaleString("en-IN") %>
                    </span>
                  </div>
                </div>

                <!-- ACTION BUTTONS -->

                <div class="mt-8 flex flex-wrap gap-4">
                  <!-- VIEW DETAILS -->

                  <a
                    href="/poeme-perfumery/orders/<%= order._id %>"
                    class="bg-[#B68D40] hover:bg-[#9A7737] text-white px-8 py-4 rounded-full font-semibold transition"
                  >
                    View Details
                  </a>

                  <!-- BUY AGAIN -->

                  <a
                    href="/poeme-perfumery/order-again/<%= order._id %>"
                    class="border border-[#B68D40] text-[#B68D40] px-8 py-4 rounded-full hover:bg-[#B68D40] hover:text-white transition"
                  >
                    Buy Again
                  </a>

                  <!-- CANCEL ORDER -->

                  <% if (
                        order.orderStatus === "confirmed" ||
                        order.orderStatus === "processing"
                      ) { %>

                  <a
                    href="/poeme-perfumery/orders/cancel/<%= order._id %>"
                    class="border border-red-300 text-red-600 px-8 py-4 rounded-full hover:bg-red-50 transition"
                  >
                    Cancel Order
                  </a>

                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% }) %>
      </div>

      <% } else { %>

      <!-- ========================= -->
      <!-- EMPTY ORDERS -->
      <!-- ========================= -->

      <div
        class="bg-white rounded-[32px] border border-stone-200 shadow-lg p-20 text-center"
      >
        <div
          class="w-40 h-40 rounded-full bg-[#F8F3EA] flex items-center justify-center mx-auto"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-20 h-20 text-[#B68D40]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 7h18M5 7l1 13h12l1-13M9 7V4h6v3"
            />
          </svg>
        </div>

        <h2 class="mt-10 text-5xl font-bold text-stone-900">No Orders Yet</h2>

        <p class="mt-5 text-lg text-stone-500 max-w-xl mx-auto leading-8">
          You haven't purchased any fragrances yet. Discover our luxury perfume
          collection and place your first order.
        </p>

        <a
          href="/poeme-perfumery/perfumes"
          class="inline-block mt-10 bg-[#B68D40] hover:bg-[#9A7737] text-white px-10 py-4 rounded-full font-semibold transition"
        >
          Explore Collection
        </a>
      </div>

      <% } %>
    </section>

    <!-- ========================= -->
    <!-- RECOMMENDED SECTION -->
    <!-- ========================= -->

    <% if (orders && orders.length > 0) { %>

    <section class="pb-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center">
          <p class="uppercase tracking-[8px] text-[#B68D40] font-semibold">
            Continue Shopping
          </p>

          <h2 class="mt-4 text-5xl font-bold text-stone-900">
            Discover More Luxury Fragrances
          </h2>

          <p class="mt-5 text-stone-500 max-w-2xl mx-auto">
            Explore our latest arrivals and timeless collections, crafted to
            leave a lasting impression.
          </p>

          <a
            href="/poeme-perfumery/perfumes"
            class="inline-block mt-10 border border-[#B68D40] text-[#B68D40] hover:bg-[#B68D40] hover:text-white px-10 py-4 rounded-full font-semibold transition"
          >
            Shop More
          </a>
        </div>
      </div>
    </section>

    <% } %>

    <!-- FOOTER -->

    <%- include("layout/footer.ejs") %>

    <!-- JS -->

    <script src="/js/index.js"></script>
  </body>
</html>
