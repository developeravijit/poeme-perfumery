<section
  id="collections"
  class="relative overflow-hidden bg-gradient-to-b from-[#FCFBF8] via-[#F9F5EE] to-[#FCFBF8] py-28"
>
  <!-- Decorative Background -->

  <div
    class="absolute -top-40 -left-32 w-[550px] h-[550px] rounded-full bg-[#F3E7D0] blur-[180px] opacity-70"
  ></div>

  <div
    class="absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full bg-[#F8EDD5] blur-[180px] opacity-80"
  ></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Heading -->

    <div class="text-center mb-20">
      <span
        class="inline-flex items-center gap-3 uppercase tracking-[7px] text-[#B68D40] text-sm font-semibold"
      >
        <span class="w-10 h-px bg-[#B68D40]"></span>

        Featured Collection

        <span class="w-10 h-px bg-[#B68D40]"></span>
      </span>

      <h2
        class="mt-6 text-5xl lg:text-6xl font-bold text-stone-900 leading-tight"
      >
        Discover Our Signature
        <br />
        Luxury Fragrances
      </h2>

      <p class="max-w-3xl mx-auto mt-8 text-lg leading-9 text-stone-500">
        Crafted from the world's finest ingredients and inspired by timeless
        elegance, every fragrance tells a story of sophistication and luxury.
      </p>
    </div>

    <% if(products && products.length){ %>

    <!-- Swiper -->

    <div class="swiper collectionSwiper pb-20">
      <div class="swiper-wrapper">
        <% products.forEach(product=>{ %>

        <div class="swiper-slide">
          <div
            class="group bg-white rounded-[34px] border border-stone-200 overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500"
          >
            <!-- Image -->

            <div
              class="relative h-[380px] overflow-hidden bg-gradient-to-br from-[#FBFAF8] via-[#F8F4EC] to-[#F3ECE0] flex items-center justify-center"
            >
              <div
                class="absolute w-64 h-64 rounded-full bg-[#E9D8B4]/60 blur-[90px]"
              ></div>

              <!-- Category Badge -->

              <div class="absolute top-6 left-6 z-20">
                <span
                  class="px-4 py-2 rounded-full bg-white/90 backdrop-blur text-xs tracking-[3px] uppercase font-semibold text-[#B68D40] shadow"
                >
                  <%= product.category.categoryName %>
                </span>
              </div>

              <!-- Stock Badge -->

              <div class="absolute top-6 right-6 z-20">
                <% if(product.stock>0){ %>

                <span
                  class="px-4 py-2 rounded-full bg-green-100 text-green-700 text-xs font-semibold"
                >
                  In Stock
                </span>

                <% }else{ %>

                <span
                  class="px-4 py-2 rounded-full bg-red-100 text-red-700 text-xs font-semibold"
                >
                  Out Of Stock
                </span>

                <% } %>
              </div>

              <% if(product.images && product.images.length){ %>

              <img
                src="<%= product.images[0].url %>"
                alt="<%= product.productName %>"
                class="relative z-10 h-[300px] object-contain transition duration-700 group-hover:scale-110 group-hover:-skew-x-1"
              />

              <% }else{ %>

              <div
                class="relative z-10 flex items-center justify-center h-full"
              >
                <i class="fa-solid fa-image text-8xl text-stone-300"></i>
              </div>

              <% } %>
            </div>

            <!-- Product Details -->

            <div class="p-8">
              <p
                class="uppercase tracking-[5px] text-xs text-[#B68D40] font-semibold"
              >
                <%= product.brand || "POÈME" %>
              </p>

              <h3
                class="mt-3 text-3xl font-bold text-stone-900 leading-tight line-clamp-2"
              >
                <%= product.productName %>
              </h3>

              <% if(product.description){ %>

              <p class="mt-5 text-stone-500 leading-8 line-clamp-2">
                <%= product.description %>
              </p>

              <% }else{ %>

              <p class="mt-5 text-stone-400 leading-8">
                Premium luxury fragrance crafted for every occasion.
              </p>

              <% } %>

              <!-- Price & Actions -->

              <div class="mt-8 flex items-center justify-between">
                <div>
                  <p class="text-sm uppercase tracking-[3px] text-stone-400">
                    Starting Price
                  </p>

                  <h3 class="mt-1 text-4xl font-bold text-[#B68D40]">
                    $<%= product.price.toLocaleString("en-US") %>
                  </h3>
                </div>
              </div>

              <!-- Features -->

              <div class="grid grid-cols-3 gap-3 mt-8">
                <div class="rounded-2xl bg-stone-50 py-4 text-center">
                  <i class="fa-solid fa-leaf text-[#B68D40] text-xl"></i>

                  <p
                    class="mt-3 text-xs uppercase tracking-[2px] text-stone-500"
                  >
                    Premium
                  </p>
                </div>

                <div class="rounded-2xl bg-stone-50 py-4 text-center">
                  <i class="fa-solid fa-gem text-[#B68D40] text-xl"></i>

                  <p
                    class="mt-3 text-xs uppercase tracking-[2px] text-stone-500"
                  >
                    Luxury
                  </p>
                </div>

                <div class="rounded-2xl bg-stone-50 py-4 text-center">
                  <i class="fa-solid fa-award text-[#B68D40] text-xl"></i>

                  <p
                    class="mt-3 text-xs uppercase tracking-[2px] text-stone-500"
                  >
                    Authentic
                  </p>
                </div>
              </div>

              <!-- Buttons -->

              <div class="grid grid-cols-2 gap-4 mt-8">
                <a
                  href="/poeme-perfumery/product/<%= product.slug %>"
                  class="rounded-2xl bg-[#B68D40] hover:bg-[#9A7636] text-white font-semibold text-center py-4 transition"
                >
                  View Details
                </a>

                <% if(product.stock>0){ %>

                <button
                  class="rounded-2xl border border-stone-300 hover:border-[#B68D40] hover:bg-[#F9F5EE] transition font-semibold"
                >
                  Add To Cart
                </button>

                <% }else{ %>

                <button
                  disabled
                  class="rounded-2xl bg-stone-100 text-stone-400 cursor-not-allowed"
                >
                  Out Of Stock
                </button>

                <% } %>
              </div>
            </div>
          </div>
        </div>

        <% }) %>
      </div>

      <!-- Navigation -->

      <div class="swiper-button-prev !text-[#B68D40]"></div>

      <div class="swiper-button-next !text-[#B68D40]"></div>

      <div class="swiper-pagination mt-10"></div>
    </div>

    <% }else{ %>

    <!-- Empty State -->

    <div
      class="bg-white rounded-[36px] shadow-xl border border-stone-200 py-24 px-10 text-center"
    >
      <div
        class="mx-auto w-28 h-28 rounded-full bg-[#F8F4EC] flex items-center justify-center"
      >
        <i class="fa-solid fa-box-open text-5xl text-[#B68D40]"></i>
      </div>

      <h3 class="mt-8 text-4xl font-bold text-stone-900">
        No Products Available
      </h3>

      <p class="mt-5 max-w-2xl mx-auto text-stone-500 leading-8">
        Our luxury collection is being updated. Please check back soon to
        discover our newest fragrances.
      </p>

      <a
        href="/poeme-perfumery/perfumes"
        class="inline-flex mt-10 items-center justify-center px-10 py-4 rounded-full bg-[#B68D40] hover:bg-[#9A7636] text-white font-semibold transition"
      >
        Browse Collection
      </a>
    </div>

    <% } %>
  </div>
</section>
