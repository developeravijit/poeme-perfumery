<main class="min-h-screen">
  <section class="p-8">

    <!-- ================= Header ================= -->

    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">

      <div>
        <h1 class="text-3xl font-bold text-slate-800">
          Product Management
        </h1>

        <p class="text-slate-500 mt-2">
          Manage all your products, stock and inventory from one place.
        </p>
      </div>

      <div class="flex gap-3">

        <a href="/poeme-perfumery/seller/bulk-upload" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-3 font-semibold transition">
          <i class="fa-solid fa-file-arrow-up"></i>
          Bulk Upload
        </a>

        <a href="/poeme-perfumery/seller/create/product" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 font-semibold transition">
          <i class="fa-solid fa-plus"></i>
          Create Product
        </a>

      </div>

    </div>

    <!-- ================= Flash Messages ================= -->

    <% if(success && success.length){ %>

    <div class="mt-8 rounded-xl border border-green-300 bg-green-100 px-5 py-4 text-green-700">
      <%= success[0] %>
    </div>

    <% } %>

    <% if(error && error.length){ %>

    <div class="mt-8 rounded-xl border border-red-300 bg-red-100 px-5 py-4 text-red-700">
      <%= error[0] %>
    </div>

    <% } %>

    <!-- ================= Statistics ================= -->

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mt-10">

      <div class="bg-white rounded-2xl shadow p-6">
        <p class="text-slate-500">Total Products</p>

        <h2 class="text-4xl font-bold mt-2">
          <%= totalProducts %>
        </h2>
      </div>

      <div class="bg-white rounded-2xl shadow p-6">
        <p class="text-slate-500">In Stock</p>

        <h2 class="text-4xl font-bold mt-2">
          <%= products.filter(product => product.stock > 0).length %>
        </h2>
      </div>

      <div class="bg-white rounded-2xl shadow p-6">
        <p class="text-slate-500">Out Of Stock</p>

        <h2 class="text-4xl font-bold mt-2">
          <%= products.filter(product => product.stock === 0).length %>
        </h2>
      </div>

      <div class="bg-white rounded-2xl shadow p-6">
        <p class="text-slate-500">Categories</p>

        <h2 class="text-4xl font-bold mt-2">
          <%= categories.length %>
        </h2>
      </div>

    </div>

    <!-- ================= Search ================= -->

    <form action="/poeme-perfumery/perfumes" method="GET" class="mt-10">

      <div class="relative max-w-md">

        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Search products..." class="w-full h-12 rounded-xl border border-slate-300 pl-12 pr-4 outline-none focus:ring-4 focus:ring-indigo-100">

        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>

      </div>

      <div class="flex flex-col xl:flex-row gap-8 mt-10">

        <!-- ================= Sidebar ================= -->

        <aside class="w-full xl:w-72">

          <div class="bg-white rounded-3xl border border-slate-200 shadow p-6 sticky top-6">

            <div class="flex justify-between items-center">

              <h2 class="text-xl font-bold">
                Filters
              </h2>

              <a href="/poeme-perfumery/perfumes" class="text-indigo-600 text-sm">
                Reset
              </a>

            </div>

            <!-- Stock -->

            <div class="mt-8">

              <h3 class="font-semibold mb-3">
                Availability
              </h3>

              <label class="flex items-center gap-2 mb-2">
                <input type="radio" name="stock" value="instock" <%= filters.stock==="instock" ? "checked" : "" %>>
                In Stock
              </label>

              <label class="flex items-center gap-2">
                <input type="radio" name="stock" value="outofstock" <%= filters.stock==="outofstock" ? "checked" : "" %>>
                Out Of Stock
              </label>

            </div>

            <!-- Category -->

            <div class="mt-8">

              <h3 class="font-semibold mb-3">
                Category
              </h3>

              <% categories.forEach(category=>{ %>

              <label class="flex items-center gap-2 mb-2">

                <input type="radio" name="category" value="<%= category._id %>" <%= filters.category==String(category._id) ? "checked" : "" %>>

                <%= category.categoryName %>

              </label>

              <% }) %>

            </div>

            <!-- Brand -->

            <div class="mt-8">

              <h3 class="font-semibold mb-3">
                Brand
              </h3>

              <% [...new Set(products.map(product=>product.brand).filter(Boolean))].forEach(brand=>{ %>

              <label class="flex items-center gap-2 mb-2">

                <input type="radio" name="brand" value="<%= brand %>" <%= filters.brand===brand ? "checked" : "" %>>

                <%= brand %>

              </label>

              <% }) %>

            </div>

            <!-- Price -->

            <div class="mt-8">

              <h3 class="font-semibold mb-3">
                Maximum Price
              </h3>

              <input type="number" name="price" value="<%= filters.price || '' %>" placeholder="Maximum Price" class="w-full rounded-xl border border-slate-300 px-4 py-3">

            </div>

            <!-- Sort -->

            <div class="mt-8">

              <h3 class="font-semibold mb-3">
                Sort By
              </h3>

              <select name="sort" class="w-full rounded-xl border border-slate-300 px-4 py-3">

                <option value="latest" <%= filters.sort==="latest" ? "selected" : "" %>>
                  Latest
                </option>

                <option value="priceLow" <%= filters.sort==="priceLow" ? "selected" : "" %>>
                  Price Low → High
                </option>

                <option value="priceHigh" <%= filters.sort==="priceHigh" ? "selected" : "" %>>
                  Price High → Low
                </option>

                <option value="name" <%= filters.sort==="name" ? "selected" : "" %>>
                  Name A-Z
                </option>

              </select>

            </div>

            <button type="submit" class="w-full mt-8 bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-semibold transition">
              Apply Filters
            </button>

          </div>

        </aside>

        <!-- ================= Products ================= -->

        <div class="flex-1">

          <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-6">
            <% if(products.length){ %>

            <% products.forEach(product=>{ %>

            <div class="bg-white rounded-3xl overflow-hidden border border-slate-200 shadow hover:shadow-xl transition duration-300">

              <!-- Product Image -->

              <div class="relative h-72 bg-slate-100 overflow-hidden">

                <% if(product.images && product.images.length){ %>

                <img src="<%= product.images[0].url %>" alt="<%= product.productName %>" class="w-full h-full object-cover hover:scale-105 transition duration-500">

                <% } else { %>

                <div class="w-full h-full flex items-center justify-center">
                  <i class="fa-solid fa-image text-6xl text-slate-300"></i>
                </div>

                <% } %>

                <% if(product.stock>0){ %>

                <span class="absolute top-4 right-4 bg-green-100 text-green-700 text-sm px-4 py-2 rounded-full font-semibold">
                  In Stock
                </span>

                <% } else { %>

                <span class="absolute top-4 right-4 bg-red-100 text-red-700 text-sm px-4 py-2 rounded-full font-semibold">
                  Out Of Stock
                </span>

                <% } %>

              </div>

              <!-- Body -->

              <div class="p-6">

                <h2 class="text-2xl font-semibold text-slate-800">
                  <%= product.productName %>
                </h2>

                <p class="text-slate-500 uppercase tracking-wide mt-1">
                  <%= product.brand || "POEME" %>
                </p>

                <div class="mt-6 space-y-4">

                  <div class="flex justify-between">
                    <span class="text-slate-500">Category</span>

                    <span class="font-semibold">
                      <%= product.category?.categoryName || "N/A" %>
                    </span>
                  </div>

                  <div class="flex justify-between">
                    <span class="text-slate-500">Price</span>

                    <span class="font-bold text-indigo-600">
                      ₹ <%= product.price %>
                    </span>
                  </div>

                  <div class="flex justify-between">
                    <span class="text-slate-500">Brand</span>

                    <span class="font-semibold">
                      <%= product.brand || "N/A" %>
                    </span>
                  </div>

                  <div class="flex justify-between items-center">

                    <span class="text-slate-500">
                      Stock
                    </span>

                    <div class="flex items-center gap-3">

                      <a href="/poeme-perfumery/seller/product/decrease-stock/<%= product._id %>" class="w-10 h-10 rounded-lg bg-red-100 hover:bg-red-200 flex items-center justify-center">
                        <i class="fa-solid fa-minus text-red-600"></i>
                      </a>

                      <span class="text-xl font-bold w-10 text-center">
                        <%= product.stock %>
                      </span>

                      <a href="/poeme-perfumery/seller/product/increase-stock/<%= product._id %>" class="w-10 h-10 rounded-lg bg-green-100 hover:bg-green-200 flex items-center justify-center">
                        <i class="fa-solid fa-plus text-green-600"></i>
                      </a>

                    </div>

                  </div>

                </div>

                <% if(product.stock===0){ %>

                <div class="mt-6 bg-red-100 text-red-700 rounded-xl py-3 text-center font-semibold">
                  Product is Out Of Stock
                </div>

                <% } %>

                <!-- Action Buttons -->


                <a href="/poeme-perfumery/addToCart/<%= product._id %>" class="mt-4 block text-center rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white py-3 font-semibold add-to-cart-btn" data-id="<%= product._id %>">
                  <i class="fa-solid fa-cart-shopping mr-2"></i>
                  <span>Add To Cart</span>
                </a>

                <a href="/poeme-perfumery/product/<%= product.slug %>" class="mt-4 block text-center rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white py-3 font-semibold">
                  View Product
                </a>

              </div>

            </div>

            <% }) %>

            <% } else { %>

            <div class="col-span-full">

              <div class="bg-white rounded-3xl border border-slate-200 shadow p-20 text-center">

                <i class="fa-solid fa-box-open text-7xl text-slate-300"></i>

                <h2 class="text-3xl font-bold text-slate-700 mt-6">
                  No Products Found
                </h2>

                <p class="text-slate-500 mt-3">
                  Try changing your filters or create a new product.
                </p>

                <a href="/poeme-perfumery/seller/create-product" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl mt-8">
                  <i class="fa-solid fa-plus"></i>

                  Create Product
                </a>

              </div>

            </div>

            <% } %>

          </div>

        </div>

      </div>
      </div>

      </div>

      </div>

    </form>

    <!-- ================= Pagination ================= -->

    <% if(typeof totalPages !== "undefined" && totalPages > 1){ %>

    <%
      const params = new URLSearchParams();

      if(filters.search){
        params.set("search", filters.search);
      }

      if(filters.category){
        params.set("category", filters.category);
      }

      if(filters.brand){
        params.set("brand", filters.brand);
      }

      if(filters.stock){
        params.set("stock", filters.stock);
      }

      if(filters.price){
        params.set("price", filters.price);
      }

      if(filters.sort){
        params.set("sort", filters.sort);
      }

      const queryString = params.toString();
    %>

    <div class="flex justify-center mt-12">

      <nav class="flex items-center gap-2">

        <!-- Previous -->

        <% if(currentPage > 1){ %>

        <a href="?<%= queryString %>&page=<%= currentPage-1 %>" class="w-11 h-11 rounded-xl bg-white border shadow hover:bg-indigo-600 hover:text-white flex items-center justify-center transition">
          <i class="fa-solid fa-chevron-left"></i>
        </a>

        <% } %>

        <!-- Page Numbers -->

        <% for(let i = 1; i <= totalPages; i++){ %>

        <% if(i === currentPage){ %>

        <span class="w-11 h-11 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-semibold">
          <%= i %>
        </span>

        <% } else { %>

        <a href="?<%= queryString %>&page=<%= i %>" class="w-11 h-11 rounded-xl bg-white border hover:bg-indigo-100 flex items-center justify-center transition">
          <%= i %>
        </a>

        <% } %>

        <% } %>

        <!-- Next -->

        <% if(currentPage < totalPages){ %>

        <a href="?<%= queryString %>&page=<%= currentPage+1 %>" class="w-11 h-11 rounded-xl bg-white border shadow hover:bg-indigo-600 hover:text-white flex items-center justify-center transition">
          <i class="fa-solid fa-chevron-right"></i>
        </a>

        <% } %>

      </nav>

    </div>

    <% } %>

  </section>
</main>