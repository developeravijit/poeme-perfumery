<main class="min-h-screen bg-slate-50">

    <!-- Hero -->
    <section class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white">
        <div class="max-w-7xl mx-auto px-6 py-20 text-center">

            <h1 class="text-5xl font-bold">
                Discover Your Signature Fragrance
            </h1>

            <p class="mt-5 text-lg text-indigo-100 max-w-2xl mx-auto">
                Browse premium perfumes from world-renowned brands. Find
                luxurious scents for every occasion.
            </p>

        </div>
    </section>

    <!-- Search -->
    <section class="max-w-7xl mx-auto px-6 -mt-10">

        <form
            action="/poeme-perfumery/perfumes"
            method="GET"
            class="bg-white rounded-2xl shadow-lg p-6">

            <div class="flex flex-col lg:flex-row gap-4">

                <div class="flex-1 relative">

                    <i
                        class="fa-solid fa-magnifying-glass absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                    </i>

                    <input
                        type="text"
                        name="search"
                        value="<%= filters.search %>"
                        placeholder="Search perfumes..."
                        class="w-full border rounded-xl pl-12 pr-4 py-4 focus:ring-2 focus:ring-indigo-500 outline-none">

                </div>

                <button
                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-10 rounded-xl font-semibold">

                    Search

                </button>

            </div>

            <div class="mt-10 grid lg:grid-cols-[280px_1fr] gap-8">

                <!-- Sidebar -->
                <aside>

                    <div class="bg-white rounded-2xl border shadow-sm p-6 sticky top-6">

                        <div class="flex justify-between items-center">

                            <h2 class="text-xl font-bold">
                                Filters
                            </h2>

                            <a
                                href="/poeme-perfumery/perfumes"
                                class="text-indigo-600 text-sm">

                                Reset

                            </a>

                        </div>

                        <!-- Categories -->

                        <div class="mt-8">

                            <h3 class="font-semibold mb-4">
                                Categories
                            </h3>

                            <% categories.forEach(category=>{ %>

                                <label class="flex items-center gap-3 mb-3 cursor-pointer">

                                    <input
                                        type="radio"
                                        name="category"
                                        value="<%= category._id %>"
                                        <%= filters.category==String(category._id) ? "checked" : "" %>>

                                    <span>
                                        <%= category.categoryName %>
                                    </span>

                                </label>

                            <% }) %>

                        </div>

                        <!-- Brand -->

                        <div class="mt-8">

                            <h3 class="font-semibold mb-4">
                                Brand
                            </h3>

                            <% [...new Set(products.map(p => p.brand).filter(Boolean))].forEach(brand=>{ %>

                                <label class="flex items-center gap-3 mb-3 cursor-pointer">

                                    <input
                                        type="radio"
                                        name="brand"
                                        value="<%= brand %>"
                                        <%= filters.brand===brand ? "checked" : "" %>>

                                    <span>
                                        <%= brand %>
                                    </span>

                                </label>

                            <% }) %>

                        </div>

                        <!-- Price -->

                        <div class="mt-8">

                            <h3 class="font-semibold mb-4">
                                Maximum Price
                            </h3>

                            <input
                                type="number"
                                name="price"
                                value="<%= filters.price %>"
                                placeholder="₹ Maximum Price"
                                class="w-full rounded-xl border px-4 py-3">

                        </div>

                        <!-- Availability -->

                        <div class="mt-8">

                            <h3 class="font-semibold mb-4">
                                Availability
                            </h3>

                            <label class="flex items-center gap-3 cursor-pointer">

                                <input
                                    type="checkbox"
                                    name="stock"
                                    value="instock"
                                    <%= filters.stock==="instock" ? "checked" : "" %>>

                                <span>
                                    In Stock Only
                                </span>

                            </label>

                        </div>

                        <!-- Sort -->

                        <div class="mt-8">

                            <h3 class="font-semibold mb-4">
                                Sort By
                            </h3>

                            <select
                                name="sort"
                                class="w-full rounded-xl border px-4 py-3">

                                <option
                                    value="latest"
                                    <%= filters.sort==="latest" ? "selected" : "" %>>

                                    Latest

                                </option>

                                <option
                                    value="priceLow"
                                    <%= filters.sort==="priceLow" ? "selected" : "" %>>

                                    Price : Low to High

                                </option>

                                <option
                                    value="priceHigh"
                                    <%= filters.sort==="priceHigh" ? "selected" : "" %>>

                                    Price : High to Low

                                </option>

                                <option
                                    value="name"
                                    <%= filters.sort==="name" ? "selected" : "" %>>

                                    Name A-Z

                                </option>

                            </select>

                        </div>

                        <button
                            class="mt-8 w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-semibold">

                            Apply Filters

                        </button>

                    </div>

                </aside>

                <!-- Products -->

                <section>

                    <div class="flex justify-between items-center mb-6">

                        <h2 class="text-2xl font-bold text-slate-800">
                            Our Collection
                        </h2>

                        <span class="text-slate-500">
                            <%= totalProducts %> Products
                        </span>

                    </div>

                    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

                        <% if(products.length){ %>

                            <% products.forEach(product=>{ %>
                                                          <div
                                class="bg-white rounded-3xl shadow-sm hover:shadow-xl transition duration-300 overflow-hidden border border-slate-200">

                                <!-- Image -->

                                <div class="relative h-72 overflow-hidden bg-slate-100">

                                    <% if(product.images && product.images.length){ %>

                                        <img
                                            src="<%= product.images[0].url %>"
                                            alt="<%= product.productName %>"
                                            class="w-full h-full object-cover hover:scale-110 transition duration-500">

                                    <% } else { %>

                                        <div class="w-full h-full flex items-center justify-center">

                                            <i class="fa-solid fa-image text-6xl text-slate-300"></i>

                                        </div>

                                    <% } %>

                                    <% if(product.stock > 0){ %>

                                        <span
                                            class="absolute top-4 right-4 bg-green-100 text-green-700 text-sm px-4 py-2 rounded-full font-semibold">

                                            In Stock

                                        </span>

                                    <% } else { %>

                                        <span
                                            class="absolute top-4 right-4 bg-red-100 text-red-700 text-sm px-4 py-2 rounded-full font-semibold">

                                            Out Of Stock

                                        </span>

                                    <% } %>

                                </div>

                                <!-- Content -->

                                <div class="p-6">

                                    <p class="text-sm uppercase tracking-wider text-indigo-600 font-semibold">

                                        <%= product.category?.categoryName || "Perfume" %>

                                    </p>

                                    <h3 class="text-2xl font-bold mt-2 text-slate-800">

                                        <%= product.productName %>

                                    </h3>

                                    <p class="mt-2 text-slate-500 line-clamp-2">

                                        <%= product.description || "Premium fragrance crafted for every occasion." %>

                                    </p>

                                    <div class="flex justify-between items-center mt-6">

                                        <div>

                                            <p class="text-slate-500 text-sm">

                                                Brand

                                            </p>

                                            <h4 class="font-semibold">

                                                <%= product.brand || "POEME" %>

                                            </h4>

                                        </div>

                                        <div class="text-right">

                                            <p class="text-slate-500 text-sm">

                                                Price

                                            </p>

                                            <h3 class="text-2xl font-bold text-indigo-600">

                                                ₹ <%= product.price %>

                                            </h3>

                                        </div>

                                    </div>

                                    <% if(product.stock > 0){ %>

                                        <a
                                            href="/poeme-perfumery/addToCart/<%= product._id %>"
                                            class="mt-6 w-full flex justify-center items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-semibold transition">

                                            <i class="fa-solid fa-cart-shopping"></i>

                                            Add To Cart

                                        </a>

                                    <% } else { %>

                                        <button
                                            disabled
                                            class="mt-6 w-full bg-slate-300 text-slate-600 py-3 rounded-xl font-semibold cursor-not-allowed">

                                            Out Of Stock

                                        </button>

                                    <% } %>

                           <a
    href="/poeme-perfumery/product/<%= product.slug %>"
    class="mt-3 block text-center border border-indigo-600 text-indigo-600 hover:bg-indigo-600 hover:text-white transition py-3 rounded-xl font-semibold"
>
    View Details
</a>

                                </div>

                            </div>

                        <% }) %>

                    <% } else { %>

                        <div class="col-span-full">

                            <div class="bg-white rounded-3xl shadow p-16 text-center">

                                <i class="fa-solid fa-box-open text-7xl text-slate-300"></i>

                                <h2 class="text-3xl font-bold mt-6">

                                    No Products Found

                                </h2>

                                <p class="text-slate-500 mt-3">

                                    We couldn't find any perfumes matching your search.
                                    Try changing your filters.

                                </p>

                                <a
                                    href="/poeme-perfumery/perfumes"
                                    class="inline-block mt-8 bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl font-semibold">

                                    Browse All Products

                                </a>

                            </div>

                        </div>

                    <% } %>

                </div>

            </section>

        </div>

    </form>

    <!-- Pagination -->

    <% if(totalPages > 1){ %>

        <%
            const params = new URLSearchParams();

            if(filters.search) params.set("search", filters.search);
            if(filters.category) params.set("category", filters.category);
            if(filters.brand) params.set("brand", filters.brand);
            if(filters.price) params.set("price", filters.price);
            if(filters.stock) params.set("stock", filters.stock);
            if(filters.sort) params.set("sort", filters.sort);

            const query = params.toString();
        %>

        <div class="flex justify-center mt-14 mb-10">

            <nav class="flex gap-2">

                <% if(currentPage > 1){ %>

                    <a
                        href="?<%= query %>&page=<%= currentPage-1 %>"
                        class="w-11 h-11 rounded-xl border bg-white hover:bg-indigo-600 hover:text-white flex items-center justify-center">

                        <i class="fa-solid fa-chevron-left"></i>

                    </a>

                <% } %>

                <% for(let i=1;i<=totalPages;i++){ %>

                    <% if(i===currentPage){ %>

                        <span
                            class="w-11 h-11 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold">

                            <%= i %>

                        </span>

                    <% }else{ %>

                        <a
                            href="?<%= query %>&page=<%= i %>"
                            class="w-11 h-11 rounded-xl bg-white border hover:bg-indigo-100 flex items-center justify-center">

                            <%= i %>

                        </a>

                    <% } %>

                <% } %>

                <% if(currentPage < totalPages){ %>

                    <a
                        href="?<%= query %>&page=<%= currentPage+1 %>"
                        class="w-11 h-11 rounded-xl border bg-white hover:bg-indigo-600 hover:text-white flex items-center justify-center">

                        <i class="fa-solid fa-chevron-right"></i>

                    </a>

                <% } %>

            </nav>

        </div>

    <% } %>

</main>