<main class="ml-72 min-h-screen">
  <section class="p-8">
    <!-- Page Header -->
    <div
      class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"
    >
      <div>
        <h1 class="text-3xl font-bold text-slate-800">Product Management</h1>

        <p class="text-slate-500 mt-2">
          Manage all your products, stock and inventory from one place.
        </p>
      </div>

      <div class="flex gap-3">
        <a
          href="/poeme-perfumery/seller/bulk-upload"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-3 font-semibold transition"
        >
          <i class="fa-solid fa-file-arrow-up"></i>

          Bulk Upload
        </a>

        <a
          href="/poeme-perfumery/seller/create/product"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 font-semibold transition"
        >
          <i class="fa-solid fa-plus"></i>

          Create Product
        </a>
      </div>
    </div>

    <!-- Flash Message -->

    <% if(typeof success !== "undefined" && success.length){ %>

    <div
      class="mt-8 rounded-xl border border-green-300 bg-green-100 px-5 py-4 text-green-700 font-medium"
    >
      <%= success[0] %>
    </div>

    <% } %>

    <% if(typeof error !== "undefined" && error.length){ %>

    <div
      class="mt-8 rounded-xl border border-red-300 bg-red-100 px-5 py-4 text-red-700 font-medium"
    >
      <%= error[0] %>
    </div>

    <% } %>

    <!-- Statistics -->

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mt-10">
      <!-- Total Products -->

      <div class="bg-white rounded-2xl shadow-sm p-6">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-slate-500">Total Products</p>

            <h2 class="text-4xl font-bold mt-2"><%= products.length %></h2>
          </div>

          <div
            class="w-14 h-14 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center"
          >
            <i class="fa-solid fa-box text-2xl"></i>
          </div>
        </div>
      </div>

      <!-- In Stock -->

      <div class="bg-white rounded-2xl shadow-sm p-6">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-slate-500">In Stock</p>

            <h2 class="text-4xl font-bold mt-2">
              <%= products.filter(product=>product.stock>0).length %>
            </h2>
          </div>

          <div
            class="w-14 h-14 rounded-xl bg-green-100 text-green-600 flex items-center justify-center"
          >
            <i class="fa-solid fa-check text-2xl"></i>
          </div>
        </div>
      </div>

      <!-- Out of Stock -->

      <div class="bg-white rounded-2xl shadow-sm p-6">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-slate-500">Out Of Stock</p>

            <h2 class="text-4xl font-bold mt-2">
              <%= products.filter(product=>product.stock===0).length %>
            </h2>
          </div>

          <div
            class="w-14 h-14 rounded-xl bg-red-100 text-red-600 flex items-center justify-center"
          >
            <i class="fa-solid fa-ban text-2xl"></i>
          </div>
        </div>
      </div>

      <!-- Categories -->

      <div class="bg-white rounded-2xl shadow-sm p-6">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-slate-500">Categories</p>

            <h2 class="text-4xl font-bold mt-2">
              <%= [...new
              Set(products.map(product=>product.category.categoryName))].length
              %>
            </h2>
          </div>

          <div
            class="w-14 h-14 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center"
          >
            <i class="fa-solid fa-layer-group text-2xl"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Search -->

    <div class="mt-10">
      <div class="relative w-full md:w-96">
        <input
          type="text"
          placeholder="Search products..."
          class="w-full h-12 rounded-xl border border-slate-300 pl-12 pr-4 outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500"
        />

        <i
          class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
        ></i>
      </div>
    </div>

    <!-- Product Grid -->

    <% if(products.length){ %>

    <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-6 mt-10">
      <% products.forEach(product=>{ %>

      <div
        class="bg-white rounded-3xl shadow hover:shadow-2xl transition-all duration-300 overflow-hidden border border-slate-200"
      >
        <!-- Product Image -->

        <div class="relative h-64 bg-slate-100 overflow-hidden">
          <% if(product.images && product.images.length){ %>

          <img
            src="<%= product.images[0].url %>"
            alt="<%= product.productName %>"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
          />

          <% }else{ %>

          <div class="w-full h-full flex items-center justify-center">
            <i class="fa-solid fa-image text-7xl text-slate-300"></i>
          </div>

          <% } %>

          <!-- Stock Badge -->

          <% if(product.stock>0){ %>

          <span
            class="absolute top-4 right-4 bg-green-100 text-green-700 text-xs font-semibold px-3 py-2 rounded-full"
          >
            In Stock
          </span>

          <% }else{ %>

          <span
            class="absolute top-4 right-4 bg-red-100 text-red-700 text-xs font-semibold px-3 py-2 rounded-full"
          >
            Out Of Stock
          </span>

          <% } %>
        </div>

        <!-- Card Body -->

        <div class="p-6">
          <!-- Product Name -->

          <div class="flex justify-between items-start">
            <div>
              <h2 class="text-xl font-bold text-slate-800">
                <%= product.productName %>
              </h2>

              <p class="mt-1 text-slate-500">
                <%= product.brand || "No Brand" %>
              </p>
            </div>
          </div>

          <!-- Details -->

          <div class="space-y-4 mt-6">
            <div class="flex justify-between">
              <span class="text-slate-500"> Category </span>

              <span class="font-semibold">
                <%= product.category.categoryName %>
              </span>
            </div>

            <div class="flex justify-between">
              <span class="text-slate-500"> Price </span>

              <span class="font-bold text-indigo-600">
                ₹ <%= product.price.toLocaleString() %>
              </span>
            </div>

            <div class="flex justify-between">
              <span class="text-slate-500"> Brand </span>

              <span class="font-medium"> <%= product.brand || "N/A" %> </span>
            </div>

            <!-- Stock Controller -->

            <div class="flex justify-between items-center">
              <span class="text-slate-500"> Stock </span>

              <div class="flex items-center gap-3">
                <a
                  href="/poeme-perfumery/seller/product/decrease-stock/<%= product._id %>"
                  class="w-10 h-10 rounded-lg bg-red-100 hover:bg-red-200 text-red-600 flex items-center justify-center transition"
                >
                  <i class="fa-solid fa-minus"></i>
                </a>

                <span class="w-10 text-center text-lg font-bold">
                  <%= product.stock %>
                </span>

                <a
                  href="/poeme-perfumery/seller/product/increase-stock/<%= product._id %>"
                  class="w-10 h-10 rounded-lg bg-green-100 hover:bg-green-200 text-green-600 flex items-center justify-center transition"
                >
                  <i class="fa-solid fa-plus"></i>
                </a>
              </div>
            </div>
          </div>

          <!-- Out Of Stock Warning -->

          <% if(product.stock===0){ %>

          <div
            class="mt-6 rounded-xl bg-red-100 text-red-700 text-center py-3 font-semibold"
          >
            Product is currently Out Of Stock
          </div>

          <% } %>

          <!-- Action Buttons -->

          <div class="grid grid-cols-2 gap-3 mt-8">
            <a
              href="/poeme-perfumery/seller/edit/product/<%= product._id %>"
              class="rounded-xl bg-blue-100 hover:bg-blue-200 text-blue-700 py-3 text-center font-semibold transition"
            >
              <i class="fa-solid fa-pen mr-2"></i>

              Edit
            </a>

            <a
              href="/poeme-perfumery/seller/delete/product/<%= product._id %>"
              class="rounded-xl bg-red-100 hover:bg-red-200 text-red-700 py-3 text-center font-semibold transition"
            >
              <i class="fa-solid fa-trash mr-2"></i>

              Delete
            </a>
          </div>

          <!-- Stock Actions -->

          <div class="mt-4">
            <% if(product.stock>0){ %>

            <a
              href="/poeme-perfumery/seller/product/out-of-stock/<%= product._id %>"
              class="block w-full rounded-xl bg-red-600 hover:bg-red-700 text-white py-3 text-center font-semibold transition"
            >
              <i class="fa-solid fa-ban mr-2"></i>

              Mark Out Of Stock
            </a>

            <% }else{ %>

            <a
              href="/poeme-perfumery/seller/product/increase-stock/<%= product._id %>"
              class="block w-full rounded-xl bg-green-600 hover:bg-green-700 text-white py-3 text-center font-semibold transition"
            >
              <i class="fa-solid fa-box-open mr-2"></i>

              Restock Product
            </a>

            <% } %>
          </div>
        </div>
      </div>

      <% }) %>
    </div>

    <% }else{ %>

    <!-- Empty State -->

    <div class="mt-12">
      <div
        class="bg-white rounded-3xl shadow-lg border border-slate-200 py-24 px-8 text-center"
      >
        <div
          class="w-28 h-28 rounded-full bg-slate-100 mx-auto flex items-center justify-center"
        >
          <i class="fa-solid fa-box-open text-6xl text-slate-300"></i>
        </div>

        <h2 class="text-3xl font-bold text-slate-800 mt-8">
          No Products Found
        </h2>

        <p class="text-slate-500 mt-4 max-w-lg mx-auto">
          You haven't added any products yet. Start building your catalog by
          creating your first product or upload products using CSV.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4 mt-10">
          <a
            href="/poeme-perfumery/seller/create/product"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-4 font-semibold transition"
          >
            <i class="fa-solid fa-plus"></i>

            Create Product
          </a>

          <a
            href="/poeme-perfumery/seller/bulk-upload"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-4 font-semibold transition"
          >
            <i class="fa-solid fa-file-arrow-up"></i>

            Bulk Upload
          </a>
        </div>
      </div>
    </div>

    <% } %>

    <!-- Pagination -->

    <% if(typeof totalPages !=='undefined' && totalPages>1){ %>

    <div class="flex justify-center mt-12">
      <nav class="flex items-center gap-2">
        <% if(currentPage>1){ %>

        <a
          href="?page=<%= currentPage-1 %>"
          class="w-11 h-11 rounded-xl bg-white shadow border hover:bg-indigo-600 hover:text-white flex items-center justify-center transition"
        >
          <i class="fa-solid fa-chevron-left"></i>
        </a>

        <% } %>

        <% for(let
                                                i=1;i<=totalPages;i++){ %>

        <% if(i===currentPage){ %>

        <span
          class="w-11 h-11 rounded-xl bg-indigo-600 text-white font-semibold flex items-center justify-center"
        >
          <%= i %>
        </span>

        <% }else{ %>

        <a
          href="?page=<%= i %>"
          class="w-11 h-11 rounded-xl bg-white border hover:bg-indigo-100 flex items-center justify-center transition"
        >
          <%= i %>
        </a>

        <% } %>

        <% } %>

        <% if(currentPage<totalPages){ %>

        <a
          href="?page=<%= currentPage+1 %>"
          class="w-11 h-11 rounded-xl bg-white shadow border hover:bg-indigo-600 hover:text-white flex items-center justify-center transition"
        >
          <i class="fa-solid fa-chevron-right"></i>
        </a>

        <% } %>
      </nav>
    </div>

    <% } %>
  </section>
</main>
