<!-- NEWSLETTER -->

<section class="pb-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-[40px] bg-gradient-to-r from-[#171717] via-[#222222] to-[#171717]"
    >
      <!-- Background Glow -->

      <div
        class="absolute -top-40 -left-32 w-[420px] h-[420px] rounded-full bg-[#B68D40]/20 blur-[160px]"
      ></div>

      <div
        class="absolute -bottom-40 right-0 w-[420px] h-[420px] rounded-full bg-[#D9B86A]/10 blur-[160px]"
      ></div>

      <div
        class="relative grid lg:grid-cols-2 gap-16 items-center px-8 md:px-12 lg:px-16 py-16"
      >
        <!-- Left -->

        <div>
          <span
            class="inline-flex items-center rounded-full border border-[#D9B86A]/30 bg-[#B68D40]/10 px-5 py-2 text-xs uppercase tracking-[4px] text-[#D9B86A]"
          >
            Exclusive Membership
          </span>

          <h2
            class="mt-8 text-4xl lg:text-5xl font-bold leading-tight text-white"
          >
            Stay Updated With
            <span class="text-[#D9B86A]"> Luxury Fragrances </span>
          </h2>

          <p class="mt-6 text-stone-400 leading-8 text-lg">
            Be the first to discover new arrivals, exclusive collections,
            seasonal offers, and members-only luxury fragrance releases.
          </p>

          <!-- Features -->

          <div class="grid sm:grid-cols-2 gap-5 mt-10">
            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 rounded-full bg-[#B68D40]/20 flex items-center justify-center"
              >
                <i class="fa-solid fa-gift text-[#D9B86A]"></i>
              </div>

              <div>
                <h4 class="font-semibold text-white">Exclusive Offers</h4>

                <p class="text-sm text-stone-400">Members only discounts</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 rounded-full bg-[#B68D40]/20 flex items-center justify-center"
              >
                <i class="fa-solid fa-bell text-[#D9B86A]"></i>
              </div>

              <div>
                <h4 class="font-semibold text-white">New Arrivals</h4>

                <p class="text-sm text-stone-400">Instant notifications</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right -->

        <div>
          <div class="rounded-[30px] bg-white p-8 md:p-10 shadow-2xl">
            <h3 class="text-3xl font-bold text-stone-900">
              Join Our Newsletter
            </h3>

            <p class="mt-3 text-stone-500 leading-7">
              Receive premium fragrance recommendations and exclusive launch
              updates directly in your inbox.
            </p>

            <form class="mt-8 space-y-5">
              <div>
                <label class="block mb-2 font-medium text-stone-700">
                  Full Name
                </label>

                <input
                  type="text"
                  placeholder="Enter your name"
                  class="w-full h-14 rounded-xl border border-stone-300 px-5 outline-none focus:border-[#B68D40] focus:ring-4 focus:ring-[#B68D40]/10"
                />
              </div>

              <div>
                <label class="block mb-2 font-medium text-stone-700">
                  Email Address
                </label>

                <input
                  type="email"
                  placeholder="Enter your email"
                  class="w-full h-14 rounded-xl border border-stone-300 px-5 outline-none focus:border-[#B68D40] focus:ring-4 focus:ring-[#B68D40]/10"
                />
              </div>

              <button
                class="w-full h-14 rounded-xl bg-[#B68D40] hover:bg-[#9D7A37] text-white font-semibold transition"
              >
                Subscribe Now
              </button>
            </form>

            <!-- Footer -->

            <div
              class="flex items-center justify-center gap-3 mt-6 text-sm text-stone-500"
            >
              <i class="fa-solid fa-lock text-[#B68D40]"> </i>

              Your information is secure. Unsubscribe anytime.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
